diff --cc net/ipv6/exthdrs.c
index 400ca6a0b9c5,03cbce842c1a..000000000000
--- a/net/ipv6/exthdrs.c
+++ b/net/ipv6/exthdrs.c
@@@ -479,7 -491,7 +479,11 @@@ static int ipv6_rpl_srh_rcv(struct sk_b
  	struct net *net = dev_net(skb->dev);
  	struct inet6_dev *idev;
  	struct ipv6hdr *oldhdr;
++<<<<<<< HEAD
 +	struct in6_addr addr;
++=======
+ 	unsigned int chdr_len;
++>>>>>>> 9e6bf146b559 (ipv6: rpl: reserve mac_len headroom when recompressed SRH grows)
  	unsigned char *buf;
