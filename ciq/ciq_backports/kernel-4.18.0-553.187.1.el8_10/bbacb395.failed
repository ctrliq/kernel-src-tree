- 	.go_demote_ok = freeze_go_demote_ok,
  	.go_callback = freeze_go_callback,
  	.go_type = LM_TYPE_NONDISK,
 -	.go_flags = GLOF_NONDISK,
  };
  
  const struct gfs2_glock_operations gfs2_iopen_glops = {
