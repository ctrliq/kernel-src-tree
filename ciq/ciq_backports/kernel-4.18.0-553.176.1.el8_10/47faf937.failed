gfs2: Minor run_queue fixes

jira KERNEL-1773
Rebuild_History Non-Buildable kernel-4.18.0-553.176.1.el8_10
commit-author Andreas Gruenbacher <agruenba@redhat.com>
commit 47faf937da43df9a84e65e5a880cf813e764971e
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-4.18.0-553.176.1.el8_10/47faf937.failed

Provide a better description of why the GLF_DEMOTE_IN_PROGRESS flag
cannot be set.

Function do_xmote() may block, so make sure it isn't called when
nonblock is true.

	Signed-off-by: Andreas Gruenbacher <agruenba@redhat.com>
	Reviewed-by: Andrew Price <anprice@redhat.com>
(cherry picked from commit 47faf937da43df9a84e65e5a880cf813e764971e)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	fs/gfs2/glock.c
diff --cc fs/gfs2/glock.c
index cea159a5d6f6,747ee7ca44e2..000000000000
--- a/fs/gfs2/glock.c
+++ b/fs/gfs2/glock.c
@@@ -858,14 -830,24 +858,19 @@@ __acquires(&gl->gl_lockref.lock
  
  	if (test_bit(GLF_LOCK, &gl->gl_flags))
  		return;
 -	set_bit(GLF_LOCK, &gl->gl_flags);
  
- 	/* While a demote is in progress, the GLF_LOCK flag must be set. */
+ 	/*
+ 	 * The GLF_DEMOTE_IN_PROGRESS flag is only set intermittently during
+ 	 * locking operations.  We have just started a locking operation by
+ 	 * setting the GLF_LOCK flag, so the GLF_DEMOTE_IN_PROGRESS flag must
+ 	 * be cleared.
+ 	 */
  	GLOCK_BUG_ON(gl, test_bit(GLF_DEMOTE_IN_PROGRESS, &gl->gl_flags));
  
 -	if (test_bit(GLF_DEMOTE, &gl->gl_flags)) {
 -		if (gl->gl_demote_state == gl->gl_state) {
 -			gfs2_demote_wake(gl);
 -			goto promote;
 -		}
 -
 +	if (test_bit(GLF_DEMOTE, &gl->gl_flags) &&
 +	    gl->gl_demote_state != gl->gl_state) {
  		if (find_first_holder(gl))
 -			goto out_unlock;
 +			return;
  		if (nonblock)
  			goto out_sched;
  		set_bit(GLF_DEMOTE_IN_PROGRESS, &gl->gl_flags);
@@@ -890,9 -857,29 +895,27 @@@
  		return;
  	}
  
