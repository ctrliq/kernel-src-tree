gfs2: Add clean argument to lm_unmount hook

jira KERNEL-1773
Rebuild_History Non-Buildable kernel-4.18.0-553.176.1.el8_10
commit-author Andreas Gruenbacher <agruenba@redhat.com>
commit 9334c73fb16b183a6d4af09ce1d445f7f89b8d49
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-4.18.0-553.176.1.el8_10/9334c73f.failed

Add a 'clean' argument to ->lm_unmount() that indicates whether the
filesystem is clean or needs recovery.  Set clean to true for normal
unmounts, and to false for withdraws.

	Signed-off-by: Andreas Gruenbacher <agruenba@redhat.com>
(cherry picked from commit 9334c73fb16b183a6d4af09ce1d445f7f89b8d49)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	fs/gfs2/ops_fstype.c
diff --cc fs/gfs2/ops_fstype.c
index cc25f07c2640,f748d320fa14..000000000000
--- a/fs/gfs2/ops_fstype.c
+++ b/fs/gfs2/ops_fstype.c
@@@ -1042,8 -1040,8 +1042,13 @@@ hostdata_error
  void gfs2_lm_unmount(struct gfs2_sbd *sdp)
  {
  	const struct lm_lockops *lm = sdp->sd_lockstruct.ls_ops;
++<<<<<<< HEAD
 +	if (likely(!gfs2_withdrawn(sdp)) && lm->lm_unmount)
 +		lm->lm_unmount(sdp);
++=======
+ 	if (!gfs2_withdrawing_or_withdrawn(sdp) && lm->lm_unmount)
+ 		lm->lm_unmount(sdp, true);
++>>>>>>> 9334c73fb16b (gfs2: Add clean argument to lm_unmount hook)
  }
  
  static int wait_on_journal(struct gfs2_sbd *sdp)
diff --git a/fs/gfs2/glock.h b/fs/gfs2/glock.h
index 7ef7c62dd790..1a053c63404f 100644
--- a/fs/gfs2/glock.h
+++ b/fs/gfs2/glock.h
@@ -124,7 +124,7 @@ struct lm_lockops {
 	void (*lm_first_done) (struct gfs2_sbd *sdp);
 	void (*lm_recovery_result) (struct gfs2_sbd *sdp, unsigned int jid,
 				    unsigned int result);
-	void (*lm_unmount) (struct gfs2_sbd *sdp);
+	void (*lm_unmount) (struct gfs2_sbd *sdp, bool clean);
 	void (*lm_withdraw) (struct gfs2_sbd *sdp);
 	void (*lm_put_lock) (struct gfs2_glock *gl);
 	int (*lm_lock) (struct gfs2_glock *gl, unsigned int req_state,
diff --git a/fs/gfs2/lock_dlm.c b/fs/gfs2/lock_dlm.c
index 19e248dee1b3..036112d658e3 100644
--- a/fs/gfs2/lock_dlm.c
+++ b/fs/gfs2/lock_dlm.c
@@ -1413,7 +1413,15 @@ static void gdlm_first_done(struct gfs2_sbd *sdp)
 		fs_err(sdp, "mount first_done error %d\n", error);
 }
 
-static void gdlm_unmount(struct gfs2_sbd *sdp)
+/*
+ * gdlm_unmount - release our lockspace
+ * @sdp: the superblock
+ * @clean: Indicates whether or not the remaining nodes in the cluster should
+ *	   perform recovery.  Recovery is necessary when a node withdraws and
+ *	   its journal remains dirty.  Recovery isn't necessary when a node
+ *	   cleanly unmounts a filesystem.
+ */
+static void gdlm_unmount(struct gfs2_sbd *sdp, bool clean)
 {
 	struct lm_lockstruct *ls = &sdp->sd_lockstruct;
 
@@ -1431,7 +1439,9 @@ static void gdlm_unmount(struct gfs2_sbd *sdp)
 release:
 	down_write(&ls->ls_sem);
 	if (ls->ls_dlm) {
-		dlm_release_lockspace(ls->ls_dlm, DLM_RELEASE_NORMAL);
+		dlm_release_lockspace(ls->ls_dlm,
+				      clean ? DLM_RELEASE_NORMAL :
+					      DLM_RELEASE_RECOVER);
 		ls->ls_dlm = NULL;
 	}
 	up_write(&ls->ls_sem);
* Unmerged path fs/gfs2/ops_fstype.c
diff --git a/fs/gfs2/util.c b/fs/gfs2/util.c
index c740b0e28474..2a6a7c6e90ef 100644
--- a/fs/gfs2/util.c
+++ b/fs/gfs2/util.c
@@ -338,7 +338,7 @@ void gfs2_withdraw(struct gfs2_sbd *sdp)
 
 		if (lm->lm_unmount) {
 			fs_err(sdp, "telling LM to unmount\n");
-			lm->lm_unmount(sdp);
+			lm->lm_unmount(sdp, false);
 		}
 		fs_err(sdp, "File system withdrawn\n");
 		dump_stack();
