gfs2: Withdraw immediately on log write errors

jira KERNEL-1773
Rebuild_History Non-Buildable kernel-4.18.0-553.176.1.el8_10
commit-author Andreas Gruenbacher <agruenba@redhat.com>
commit 0e2038a90cad0f88806bf9ccc65a9309e920611a
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-4.18.0-553.176.1.el8_10/0e2038a9.failed

Now that gfs2_withdraw() is asynchronous, immediately withdraw when
a log write error is detected.

	Signed-off-by: Andreas Gruenbacher <agruenba@redhat.com>
(cherry picked from commit 0e2038a90cad0f88806bf9ccc65a9309e920611a)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	fs/gfs2/glock.c
diff --cc fs/gfs2/glock.c
index 8310a4b19010,7dd96086eeaa..000000000000
--- a/fs/gfs2/glock.c
+++ b/fs/gfs2/glock.c
@@@ -750,11 -726,12 +751,12 @@@ __acquires(&gl->gl_lockref.lock
  		 */
  		if ((atomic_read(&gl->gl_ail_count) != 0) &&
  		    (!cmpxchg(&sdp->sd_log_error, 0, -EIO))) {
 -			gfs2_glock_assert_warn(gl,
 -					       !atomic_read(&gl->gl_ail_count));
 +			gfs2_assert_warn(sdp, !atomic_read(&gl->gl_ail_count));
  			gfs2_dump_glock(NULL, gl, true);
+ 			gfs2_withdraw(sdp);
  		}
  		glops->go_inval(gl, target == LM_ST_DEFERRED ? 0 : DIO_METADATA);
 +		clear_bit(GLF_INVALIDATE_IN_PROGRESS, &gl->gl_flags);
  	}
  	spin_lock(&gl->gl_lockref.lock);
  
@@@ -781,8 -757,6 +783,11 @@@ skip_inval
  	 * gfs2_gl_hash_clear calls clear_glock) and recovery is complete
  	 * then it's okay to tell dlm to unlock it.
  	 */
++<<<<<<< HEAD
 +	if (unlikely(sdp->sd_log_error && !gfs2_withdrawn(sdp)))
 +		gfs2_withdraw_delayed(sdp);
++=======
++>>>>>>> 0e2038a90cad (gfs2: Withdraw immediately on log write errors)
  	if (glock_blocked_by_withdraw(gl) &&
  	    (target != LM_ST_UNLOCKED ||
  	     test_bit(SDF_WITHDRAW_RECOVERY, &sdp->sd_flags))) {
* Unmerged path fs/gfs2/glock.c
diff --git a/fs/gfs2/log.c b/fs/gfs2/log.c
index ff85ca4c67fc..f73437bb634e 100644
--- a/fs/gfs2/log.c
+++ b/fs/gfs2/log.c
@@ -1293,17 +1293,6 @@ int gfs2_logd(void *data)
 		if (gfs2_withdrawn(sdp))
 			break;
 
-		/* Check for errors writing to the journal */
-		if (sdp->sd_log_error) {
-			gfs2_lm(sdp,
-				"GFS2: fsid=%s: error %d: "
-				"withdrawing the file system to "
-				"prevent further damage.\n",
-				sdp->sd_fsname, sdp->sd_log_error);
-			gfs2_withdraw(sdp);
-			break;
-		}
-
 		if (gfs2_jrnl_flush_reqd(sdp) || t == 0) {
 			down_write(&sdp->sd_log_flush_lock);
 			gfs2_ail1_empty(sdp, 0);
@@ -1331,7 +1320,6 @@ int gfs2_logd(void *data)
 		t = wait_event_interruptible_timeout(sdp->sd_logd_waitq,
 				gfs2_ail_flush_reqd(sdp) ||
 				gfs2_jrnl_flush_reqd(sdp) ||
-				sdp->sd_log_error ||
 				gfs2_withdrawn(sdp) ||
 				kthread_should_stop(),
 				t);
