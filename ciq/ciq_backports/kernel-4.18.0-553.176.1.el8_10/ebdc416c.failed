  					   &ip->i_iopen_gh);
  		gfs2_glock_put(io_gl);
  		if (unlikely(error))
@@@ -811,18 -715,14 +815,19 @@@ static int gfs2_create_inode(struct ino
  
  	error = gfs2_glock_get(sdp, ip->i_no_addr, &gfs2_iopen_glops, CREATE, &io_gl);
  	if (error)
