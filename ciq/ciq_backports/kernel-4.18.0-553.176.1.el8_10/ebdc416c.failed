+ 				   LM_FLAG_NOEXP | GL_EXACT | GL_NOPID,
+ 				   &sdp->sd_live_gh);
+ 		gfs2_glock_nq(&sdp->sd_live_gh);
++>>>>>>> ebdc416c9c0b (gfs2: Mark the remaining process-independent glock holders as GL_NOPID)
