 +		if (blktype == GFS2_BLKST_UNLINKED)
 +			extra_flags |= LM_FLAG_TRY;
 +		else
  			gfs2_cancel_delete_work(io_gl);
  		error = gfs2_glock_nq_init(io_gl, LM_ST_SHARED,
