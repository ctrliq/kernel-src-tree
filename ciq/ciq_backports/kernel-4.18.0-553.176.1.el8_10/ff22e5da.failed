gfs2: only apply DLM_LKF_VALBLK if sb_lvbptr is not NULL

jira KERNEL-1773
Rebuild_History Non-Buildable kernel-4.18.0-553.176.1.el8_10
commit-author Alexander Aring <aahringo@redhat.com>
commit ff22e5da42c0adfacfa85f315b90af3706d955bd
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-4.18.0-553.176.1.el8_10/ff22e5da.failed

Currently, gfs2 always sets the DLM_LKF_VALBLK flag to enable lvb
handling even when sb_lvbptr is NULL.  This currently causes no problems
because DLM ignores the DLM_LKF_VALBLK flag when sb_lvbptr is NULL, but
it does violate the DLM API.  Fix that by only setting DLM_LKF_VALBLK
when sb_lvbptr is not NULL.

	Signed-off-by: Alexander Aring <aahringo@redhat.com>
	Signed-off-by: Andreas Gruenbacher <agruenba@redhat.com>
(cherry picked from commit ff22e5da42c0adfacfa85f315b90af3706d955bd)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	fs/gfs2/lock_dlm.c
diff --cc fs/gfs2/lock_dlm.c
index 7bc6a592927f,7cb9d216d8bb..000000000000
--- a/fs/gfs2/lock_dlm.c
+++ b/fs/gfs2/lock_dlm.c
@@@ -349,14 -362,12 +350,22 @@@ static void gdlm_put_lock(struct gfs2_g
  		return;
  	}
  
+ 	if (gl->gl_lksb.sb_lvbptr)
+ 		flags |= DLM_LKF_VALBLK;
+ 
  again:
++<<<<<<< HEAD
 +	down_read(&ls->ls_sem);
 +	error = -ENODEV;
 +	if (likely(ls->ls_dlm != NULL)) {
 +		error = dlm_unlock(ls->ls_dlm, gl->gl_lksb.sb_lkid,
 +				   DLM_LKF_VALBLK, NULL, gl);
 +	}
 +	up_read(&ls->ls_sem);
++=======
+ 	error = dlm_unlock(ls->ls_dlm, gl->gl_lksb.sb_lkid, flags,
+ 			   NULL, gl);
++>>>>>>> ff22e5da42c0 (gfs2: only apply DLM_LKF_VALBLK if sb_lvbptr is not NULL)
  	if (error == -EBUSY) {
  		msleep(20);
  		goto again;
* Unmerged path fs/gfs2/lock_dlm.c
