diff --cc drivers/net/ethernet/microsoft/mana/hw_channel.c
index f1e991fa7473,fd8b324d7fb6..000000000000
--- a/drivers/net/ethernet/microsoft/mana/hw_channel.c
+++ b/drivers/net/ethernet/microsoft/mana/hw_channel.c
@@@ -100,6 -76,38 +100,41 @@@ static int mana_hwc_post_rx_wqe(const s
  	return err;
  }
  
++<<<<<<< HEAD
++=======
+ static void mana_hwc_handle_resp(struct hw_channel_context *hwc, u32 resp_len,
+ 				 struct hwc_work_request *rx_req, u16 msg_id)
+ {
+ 	const struct gdma_resp_hdr *resp_msg = rx_req->buf_va;
+ 	struct hwc_caller_ctx *ctx;
+ 	int err;
+ 
+ 	if (!test_bit(msg_id, hwc->inflight_msg_res.map)) {
+ 		dev_err(hwc->dev, "hwc_rx: invalid msg_id = %u\n", msg_id);
+ 		mana_hwc_post_rx_wqe(hwc->rxq, rx_req);
+ 		return;
+ 	}
+ 
+ 	ctx = hwc->caller_ctx + msg_id;
+ 	err = mana_hwc_verify_resp_msg(ctx, resp_msg, resp_len);
+ 	if (err)
+ 		goto out;
+ 
+ 	ctx->status_code = resp_msg->status;
+ 
+ 	memcpy(ctx->output_buf, resp_msg, resp_len);
+ out:
+ 	ctx->error = err;
+ 
+ 	/* Must post rx wqe before complete(), otherwise the next rx may
+ 	 * hit no_wqe error.
+ 	 */
+ 	mana_hwc_post_rx_wqe(hwc->rxq, rx_req);
+ 
+ 	complete(&ctx->comp_event);
+ }
+ 
++>>>>>>> 35f0f0a2536a (net: mana: Fix TOCTOU double-fetch of hwc_msg_id from DMA buffer)
  static void mana_hwc_init_event_handler(void *ctx, struct gdma_queue *q_self,
  					struct gdma_event *event)
  {
@@@ -240,14 -278,12 +280,18 @@@ static void mana_hwc_rx_event_handler(v
  		return;
  	}
  
