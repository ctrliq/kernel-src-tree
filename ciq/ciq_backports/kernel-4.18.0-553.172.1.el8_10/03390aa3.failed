	Reviewed-by: Willem de Bruijn <willemb@google.com>
Link: https://patch.msgid.link/20260805125729.19220-3-q.h.hack.winter@gmail.com
	Signed-off-by: Jakub Kicinski <kuba@kernel.org>
(cherry picked from commit 03390aa32e669cc4ecd7d34108e2e1afc13d689d)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	include/linux/netdevice.h
#	net/packet/af_packet.c
diff --cc include/linux/netdevice.h
index cef072e7cfbb,8840b126979f..000000000000
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@@ -284,10 -300,14 +284,18 @@@ struct hh_cache 
   * We could use other alignment values, but we must maintain the
   * relationship HH alignment <= LL alignment.
   */
++<<<<<<< HEAD
 +#define LL_RESERVED_SPACE(dev) \
 +	((((dev)->hard_header_len+(dev)->needed_headroom)&~(HH_DATA_MOD - 1)) + HH_DATA_MOD)
++=======
+ #define LL_RESERVED_SPACE_EX(dev, hlen) \
+ 	((((hlen) + READ_ONCE((dev)->needed_headroom)) \
+ 	  & ~(HH_DATA_MOD - 1)) + HH_DATA_MOD)
+ #define LL_RESERVED_SPACE(dev) \
+ 	LL_RESERVED_SPACE_EX(dev, (dev)->hard_header_len)
++>>>>>>> 03390aa32e66 (packet: use consistent hard_header_len in non-ring send paths)
  #define LL_RESERVED_SPACE_EXTRA(dev,extra) \
 -	((((dev)->hard_header_len + READ_ONCE((dev)->needed_headroom) + (extra)) \
 -	  & ~(HH_DATA_MOD - 1)) + HH_DATA_MOD)
 +	((((dev)->hard_header_len+(dev)->needed_headroom+(extra))&~(HH_DATA_MOD - 1)) + HH_DATA_MOD)
  
  struct header_ops {
  	int	(*create) (struct sk_buff *skb, struct net_device *dev,
