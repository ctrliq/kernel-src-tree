diff --cc lib/iov_iter.c
index 059f3bf7d78c,34a52e9ba9e1..000000000000
--- a/lib/iov_iter.c
+++ b/lib/iov_iter.c
@@@ -1853,3 -1863,108 +1853,111 @@@ ssize_t iov_iter_extract_pages(struct i
