# Conflicts:
#	net/openvswitch/vport-netdev.c
diff --cc net/openvswitch/vport-netdev.c
index c13aacde659c,12055af832dc..000000000000
--- a/net/openvswitch/vport-netdev.c
+++ b/net/openvswitch/vport-netdev.c
@@@ -185,9 -195,7 +185,13 @@@ void ovs_netdev_tunnel_destroy(struct v
  	 * if it's not already shutting down.
  	 */
  	if (vport->dev->reg_state == NETREG_REGISTERED)
++<<<<<<< HEAD
 +		rtnl_delete_link(vport->dev);
 +	dev_put(vport->dev);
 +	vport->dev = NULL;
++=======
+ 		rtnl_delete_link(vport->dev, 0, NULL);
++>>>>>>> 6931d21f87bc (openvswitch: defer tunnel netdev_put to RCU release)
  	rtnl_unlock();
  
  	call_rcu(&vport->rcu, vport_netdev_free);
* Unmerged path net/openvswitch/vport-netdev.c
