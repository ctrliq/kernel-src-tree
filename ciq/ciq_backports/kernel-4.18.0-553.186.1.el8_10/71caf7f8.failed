# Conflicts:
#	drivers/scsi/st.c
diff --cc drivers/scsi/st.c
index fd7ce9c041c5,a757646c8dc6..000000000000
--- a/drivers/scsi/st.c
+++ b/drivers/scsi/st.c
@@@ -4544,9 -4518,8 +4544,12 @@@ static int st_remove(struct device *dev
  	spin_lock(&st_index_lock);
  	idr_remove(&st_index_idr, index);
  	spin_unlock(&st_index_lock);
++<<<<<<< HEAD
 +	return 0;
++=======
+ 	kref_put(&tpnt->kref, scsi_tape_release);
+ 	mutex_unlock(&st_ref_mutex);
++>>>>>>> 71caf7f84bd6 (scsi: st: Fix use-after-free race between st_remove() and st_open())
  }
  
