 +static int cifs_write_one_page(struct folio *folio,
 +		struct writeback_control *wbc, void *data)
 +{
 +	struct address_space *mapping = data;
 +	int ret;
 +
 +	ret = cifs_writepage_locked(&folio->page, wbc);
 +	folio_unlock(folio);
 +	mapping_set_error(mapping, ret);
 +	return ret;
 +}
