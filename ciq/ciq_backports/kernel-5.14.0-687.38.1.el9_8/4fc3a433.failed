 +	wdata->pid = wdata->cfile->pid;
 +
 +	rc = adjust_credits(wdata->server, &wdata->credits, wdata->bytes);
 +	if (rc)
 +		return rc;
 +
 +	if (wdata->cfile->invalidHandle)
 +		rc = -EAGAIN;
 +	else
 +		rc = wdata->server->ops->async_writev(wdata,
 +						      cifs_writedata_release);
 +
 +	return rc;
 +}
