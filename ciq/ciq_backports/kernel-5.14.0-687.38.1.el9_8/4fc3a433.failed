 +	/* Indication to update ctime and mtime as close is deferred */
 +	set_bit(CIFS_INO_MODIFIED_ATTR, &CIFS_I(inode)->flags);
 +	return rc;
 +}
 +
 +static int
 +cifs_writepage_locked(struct page *page, struct writeback_control *wbc)
 +{
