 +	if (ctx->enc) {
 +		/*
 +		 * Encryption operation - The in-place cipher operation is
 +		 * achieved by the following operation:
 +		 *
 +		 * TX SGL: AAD || PT
 +		 *	    |	   |
 +		 *	    | copy |
 +		 *	    v	   v
 +		 * RX SGL: AAD || PT || Tag
