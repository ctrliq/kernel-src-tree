+++ b/crypto/algif_skcipher.c
@@@ -90,8 -129,15 +90,17 @@@ static int _skcipher_recvmsg(struct soc
  	 * If more buffers are to be expected to be processed, process only
  	 * full block size buffers.
  	 */
++<<<<<<< HEAD
 +	if (ctx->more || len < ctx->used)
++=======
+ 	if (ctx->more || len < ctx->used) {
+ 		if (len < bs) {
+ 			err = -EINVAL;
+ 			goto free;
+ 		}
+ 
++>>>>>>> 8eceab19eba9 (crypto: af_alg - limit RX SG extraction by receive buffer budget)
  		len -= len % bs;
 -		cflags |= CRYPTO_SKCIPHER_REQ_NOTFINAL;
 -	}
  
  	/*
  	 * Create a per request TX SGL for this request which tracks the
diff --git a/crypto/af_alg.c b/crypto/af_alg.c
index 84cc5ed24ff3..643a30075e7d 100644
--- a/crypto/af_alg.c
+++ b/crypto/af_alg.c
@@ -1145,6 +1145,8 @@ int af_alg_get_rsgl(struct sock *sk, struct msghdr *msg, int flags,
 
 		seglen = min_t(size_t, (maxsize - len),
 			       msg_data_left(msg));
+		/* Never pin more pages than the remaining RX accounting budget. */
+		seglen = min_t(size_t, seglen, af_alg_rcvbuf(sk));
 
 		if (list_empty(&areq->rsgl_list)) {
 			rsgl = &areq->first_rsgl;
