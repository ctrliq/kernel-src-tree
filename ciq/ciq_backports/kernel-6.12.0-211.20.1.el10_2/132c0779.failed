--- a/include/net/bluetooth/hci.h
+++ b/include/net/bluetooth/hci.h
@@ -1882,6 +1882,15 @@ struct hci_cp_le_set_default_phy {
 #define HCI_LE_SET_PHY_2M		0x02
 #define HCI_LE_SET_PHY_CODED		0x04
 
