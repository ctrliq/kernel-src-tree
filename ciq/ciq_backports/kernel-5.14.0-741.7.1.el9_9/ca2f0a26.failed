  	xgr	%r11,%r11
 +	xgr	%r12,%r12
  	la	%r2,STACK_FRAME_OVERHEAD(%r15)	# pointer to pt_regs
  	mvc	__PT_R8(64,%r2),__LC_SAVE_AREA_SYNC
- 	MBEAR	%r2
+ 	MBEAR	%r2,%r0
  	lgr	%r3,%r14
  	brasl	%r14,__do_syscall
  	STACKLEAK_ERASE
@@@ -424,10 -423,9 +430,10 @@@ SYM_CODE_START(\name
