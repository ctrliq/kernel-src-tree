s390/entry: Fix setting _CIF_MCCK_GUEST with lowcore relocation

jira KERNEL-1869
Rebuild_History Non-Buildable kernel-5.14.0-741.7.1.el9_9
commit-author Sven Schnelle <svens@linux.ibm.com>
commit 121df45b37a1016ee6828c2ca3ba825f3e18a8c1
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-5.14.0-741.7.1.el9_9/121df45b.failed

When lowcore relocation is enabled, the machine check handler doesn't
use the lowcore address when setting _CIF_MCCK_GUEST. Fix this by
adding the missing base register.

Fixes: 0001b7bbc53a ("s390/entry: Make mchk_int_handler() ready for lowcore relocation")
	Reported-by: Heiko Carstens <hca@linux.ibm.com>
	Reviewed-by: Heiko Carstens <hca@linux.ibm.com>
	Signed-off-by: Sven Schnelle <svens@linux.ibm.com>
	Signed-off-by: Vasily Gorbik <gor@linux.ibm.com>
(cherry picked from commit 121df45b37a1016ee6828c2ca3ba825f3e18a8c1)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	arch/s390/kernel/entry.S
diff --cc arch/s390/kernel/entry.S
index e64f61ec06f2,dd291c9ad6a6..000000000000
--- a/arch/s390/kernel/entry.S
+++ b/arch/s390/kernel/entry.S
@@@ -495,18 -468,19 +495,23 @@@ SYM_CODE_START(mcck_int_handler
  	clgrjl	%r9,%r14, 4f
  	larl	%r14,.Lsie_leave
  	clgrjhe	%r9,%r14, 4f
++<<<<<<< HEAD
 +	oi	__LC_CPU_FLAGS+7, _CIF_MCCK_GUEST
++=======
+ 	lg	%r10,__LC_PCPU(%r13)
+ 	oi	__PCPU_FLAGS+7(%r10), _CIF_MCCK_GUEST
++>>>>>>> 121df45b37a1 (s390/entry: Fix setting _CIF_MCCK_GUEST with lowcore relocation)
  4:	BPENTER	__SF_SIE_FLAGS(%r15),_TIF_ISOLATE_BP_GUEST
 -	SIEEXIT __SF_SIE_CONTROL(%r15),%r13
 +	SIEEXIT __SF_SIE_CONTROL(%r15),%r0
  #endif
  .Lmcck_user:
 -	lg	%r15,__LC_MCCK_STACK(%r13)
 +	lg	%r15,__LC_MCCK_STACK
  	la	%r11,STACK_FRAME_OVERHEAD(%r15)
  	stctg	%c1,%c1,__PT_CR1(%r11)
 -	lctlg	%c1,%c1,__LC_KERNEL_ASCE(%r13)
 +	lctlg	%c1,%c1,__LC_KERNEL_ASCE
  	xc	__SF_BACKCHAIN(8,%r15),__SF_BACKCHAIN(%r15)
 -	lay	%r14,__LC_GPREGS_SAVE_AREA(%r13)
 -	mvc	__PT_R0(128,%r11),0(%r14)
 +	lghi	%r14,__LC_GPREGS_SAVE_AREA+64
 +	stmg	%r0,%r7,__PT_R0(%r11)
  	# clear user controlled registers to prevent speculative use
  	xgr	%r0,%r0
  	xgr	%r1,%r1
* Unmerged path arch/s390/kernel/entry.S
