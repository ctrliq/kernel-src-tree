+#include <linux/cpufeature.h>
 #include <linux/hugetlb.h>
 #include <linux/proc_fs.h>
 #include <linux/vmalloc.h>
@@ -378,7 +379,7 @@ int __set_memory(unsigned long addr, unsigned long numpages, unsigned long flags
