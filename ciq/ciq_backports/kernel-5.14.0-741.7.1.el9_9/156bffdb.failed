++<<<<<<< HEAD
 +/*
 + * Allocate some memory and give it an address in the guest physical address
 + * space.
 + *
 + * Discontiguous memory is allowed, mostly for framebuffers.
 + *
 + * Must be called holding kvm->slots_lock for write.
 + */
 +int __kvm_set_memory_region(struct kvm *kvm,
 +			    const struct kvm_userspace_memory_region2 *mem)
++=======
+ static int __kvm_set_memory_region(struct kvm *kvm,
+ 				   const struct kvm_userspace_memory_region2 *mem)
++>>>>>>> 156bffdb2b49 (KVM: Add a dedicated API for setting KVM-internal memslots)
  {
  	struct kvm_memory_slot *old, *new;
  	struct kvm_memslots *slots;
diff --git a/arch/x86/kvm/x86.c b/arch/x86/kvm/x86.c
index becf4ba407e1..8e2f00407238 100644
--- a/arch/x86/kvm/x86.c
+++ b/arch/x86/kvm/x86.c
@@ -12993,7 +12993,7 @@ void __user * __x86_set_memory_region(struct kvm *kvm, int id, gpa_t gpa,
 		m.guest_phys_addr = gpa;
 		m.userspace_addr = hva;
 		m.memory_size = size;
-		r = __kvm_set_memory_region(kvm, &m);
+		r = kvm_set_internal_memslot(kvm, &m);
 		if (r < 0)
 			return ERR_PTR_USR(r);
 	}
diff --git a/include/linux/kvm_host.h b/include/linux/kvm_host.h
index d820a62e9791..eeb040dfb7f7 100644
--- a/include/linux/kvm_host.h
+++ b/include/linux/kvm_host.h
