	Signed-off-by: Chun-Yi Lee <jlee@suse.com>
	Signed-off-by: Luiz Augusto von Dentz <luiz.von.dentz@intel.com>
(cherry picked from commit 88cd6e6b2d327faa13e4505b07f1e380e51b21ff)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	net/bluetooth/mgmt.c
diff --cc net/bluetooth/mgmt.c
index df018eebb302,965f621ef865..000000000000
--- a/net/bluetooth/mgmt.c
+++ b/net/bluetooth/mgmt.c
@@@ -4986,10 -5485,8 +4986,15 @@@ static int remove_adv_monitor(struct so
  		goto unlock;
  	}
  
++<<<<<<< HEAD
 +	if (handle)
 +		pending = hci_remove_single_adv_monitor(hdev, handle, &err);
 +	else
 +		pending = hci_remove_all_adv_monitor(hdev, &err);
++=======
+ 	err = hci_cmd_sync_submit(hdev, mgmt_remove_adv_monitor_sync, cmd,
+ 				  mgmt_remove_adv_monitor_complete);
++>>>>>>> 88cd6e6b2d32 (Bluetooth: hci_sync: Using hci_cmd_sync_submit when removing Adv Monitor)
  
  	if (err) {
  		mgmt_pending_remove(cmd);
* Unmerged path net/bluetooth/mgmt.c
