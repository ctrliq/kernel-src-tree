cifs: add validation check for the fields in smb_aces

jira KERNEL-1078
Rebuild_History Non-Buildable kernel-4.18.0-553.126.1.el8_10
commit-author Namjae Jeon <linkinjeon@kernel.org>
commit eeb827f2922eb07ffbf7d53569cc95b38272646f
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-4.18.0-553.126.1.el8_10/eeb827f2.failed

cifs.ko is missing validation check when accessing smb_aces.
This patch add validation check for the fields in smb_aces.

	Signed-off-by: Namjae Jeon <linkinjeon@kernel.org>
	Signed-off-by: Steve French <stfrench@microsoft.com>
(cherry picked from commit eeb827f2922eb07ffbf7d53569cc95b38272646f)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	fs/cifs/cifsacl.c
diff --cc fs/cifs/cifsacl.c
index 0af6988cb2f4,63b3b1290bed..000000000000
--- a/fs/cifs/cifsacl.c
+++ b/fs/cifs/cifsacl.c
@@@ -802,7 -811,23 +802,27 @@@ static void parse_dacl(struct cifs_acl 
  			return;
  
  		for (i = 0; i < num_aces; ++i) {
++<<<<<<< HEAD:fs/cifs/cifsacl.c
 +			ppace[i] = (struct cifs_ace *) (acl_base + acl_size);
++=======
+ 			if (end_of_acl - acl_base < acl_size)
+ 				break;
+ 
+ 			ppace[i] = (struct smb_ace *) (acl_base + acl_size);
+ 			acl_base = (char *)ppace[i];
+ 			acl_size = offsetof(struct smb_ace, sid) +
+ 				offsetof(struct smb_sid, sub_auth);
+ 
+ 			if (end_of_acl - acl_base < acl_size ||
+ 			    ppace[i]->sid.num_subauth == 0 ||
+ 			    ppace[i]->sid.num_subauth > SID_MAX_SUB_AUTHORITIES ||
+ 			    (end_of_acl - acl_base <
+ 			     acl_size + sizeof(__le32) * ppace[i]->sid.num_subauth) ||
+ 			    (le16_to_cpu(ppace[i]->size) <
+ 			     acl_size + sizeof(__le32) * ppace[i]->sid.num_subauth))
+ 				break;
+ 
++>>>>>>> eeb827f2922e (cifs: add validation check for the fields in smb_aces):fs/smb/client/cifsacl.c
  #ifdef CONFIG_CIFS_DEBUG2
  			dump_ace(ppace[i], end_of_acl);
  #endif
@@@ -844,9 -869,8 +864,8 @@@
  
  /*			memcpy((void *)(&(cifscred->aces[i])),
  				(void *)ppace[i],
 -				sizeof(struct smb_ace)); */
 +				sizeof(struct cifs_ace)); */
  
- 			acl_base = (char *)ppace[i];
  			acl_size = le16_to_cpu(ppace[i]->size);
  		}
  
