# Conflicts:
#	net/can/raw.c
diff --cc net/can/raw.c
index b40418a5fae2,58a96e933deb..000000000000
--- a/net/can/raw.c
+++ b/net/can/raw.c
@@@ -337,10 -395,12 +345,12 @@@ static int raw_init(struct sock *sk
  	if (unlikely(!ro->uniq))
  		return -ENOMEM;
  
+ 	sk->sk_destruct = raw_sock_destruct;
+ 
  	/* set notifier */
 -	spin_lock(&raw_notifier_lock);
 -	list_add_tail(&ro->notifier, &raw_notifier_list);
 -	spin_unlock(&raw_notifier_lock);
 +	ro->notifier.notifier_call = raw_notifier;
 +
 +	register_netdevice_notifier(&ro->notifier);
  
  	return 0;
  }
@@@ -377,9 -443,9 +387,15 @@@ static int raw_release(struct socket *s
  		kfree(ro->filter);
  
  	ro->ifindex = 0;
++<<<<<<< HEAD
 +	ro->bound   = 0;
 +	ro->count   = 0;
 +	free_percpu(ro->uniq);
++=======
+ 	ro->bound = 0;
+ 	ro->dev = NULL;
+ 	ro->count = 0;
++>>>>>>> a535a9217ca3 (can: raw: fix ro->uniq use-after-free in raw_rcv())
  
  	sock_orphan(sk);
  	sock->sk = NULL;
* Unmerged path net/can/raw.c
