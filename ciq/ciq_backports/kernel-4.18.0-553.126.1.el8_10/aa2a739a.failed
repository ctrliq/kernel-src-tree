+ 				(offsetof(struct smb_ace, sid) +
+ 				 offsetof(struct smb_sid, sub_auth) + sizeof(__le16)))
+ 			return;
+ 
+ 		ppace = kmalloc_array(num_aces, sizeof(struct smb_ace *),
++>>>>>>> aa2a739a75ab (cifs: fix incorrect validation for num_aces field of smb_acl):fs/smb/client/cifsacl.c
  				      GFP_KERNEL);
  		if (!ppace)
  			return;
