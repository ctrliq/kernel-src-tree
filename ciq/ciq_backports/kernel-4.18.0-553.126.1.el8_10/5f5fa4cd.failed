  {
  	struct mgmt_rp_add_adv_patterns_monitor rp;
 -	struct mgmt_pending_cmd *cmd = data;
 +	struct mgmt_pending_cmd *cmd;
  	struct adv_monitor *monitor;
++<<<<<<< HEAD
