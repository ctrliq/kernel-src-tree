+++ b/crypto/af_alg.c
@@@ -828,9 -846,15 +829,21 @@@ int af_alg_sendmsg(struct socket *sock
  	}
  
  	lock_sock(sk);
++<<<<<<< HEAD
 +	if (!ctx->more && ctx->used) {
 +		err = -EINVAL;
 +		goto unlock;
++=======
+ 	if (ctx->init && !ctx->more) {
+ 		if (ctx->used) {
+ 			err = -EINVAL;
+ 			goto unlock;
+ 		}
+ 
+ 		pr_info_once(
+ 			"%s sent an empty control message without MSG_MORE.\n",
+ 			current->comm);
++>>>>>>> c195d66a8a75 (crypto: af_alg - Work around empty control messages without MSG_MORE)
  	}
  	ctx->init = true;
  
