diff --cc drivers/i3c/master/svc-i3c-master.c
index a7bfc678153e,486c22840ea9..000000000000
--- a/drivers/i3c/master/svc-i3c-master.c
+++ b/drivers/i3c/master/svc-i3c-master.c
@@@ -374,11 -444,22 +374,16 @@@ static int svc_i3c_master_handle_ibi(st
  		return ret;
  	}
  
 -	slot = i3c_generic_ibi_get_free_slot(data->ibi_pool);
 -	if (!slot) {
 -		dev_dbg(master->dev, "No free ibi slot, drop the data\n");
 -		writel(SVC_I3C_MDATACTRL_FLUSHRB, master->regs + SVC_I3C_MDATACTRL);
 -		return -ENOSPC;
 -	}
 -
 -	slot->len = 0;
 -	buf = slot->data;
 -
  	while (SVC_I3C_MSTATUS_RXPEND(readl(master->regs + SVC_I3C_MSTATUS))  &&
- 	       slot->len < SVC_I3C_FIFO_SIZE) {
+ 	       slot->len < dev->ibi->max_payload_len) {
  		mdatactrl = readl(master->regs + SVC_I3C_MDATACTRL);
  		count = SVC_I3C_MDATACTRL_RXCOUNT(mdatactrl);
++<<<<<<< HEAD
 +		readsl(master->regs + SVC_I3C_MRDATAB, buf, count);
++=======
+ 		count = min(count, dev->ibi->max_payload_len - slot->len);
+ 		readsb(master->regs + SVC_I3C_MRDATAB, buf, count);
++>>>>>>> e2bda39d7f9f (i3c: master: svc: bound IBI payload to the requested max_payload_len)
  		slot->len += count;
  		buf += count;
  	}
