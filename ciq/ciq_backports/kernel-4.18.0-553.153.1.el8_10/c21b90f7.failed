diff --cc arch/x86/kernel/cpu/amd.c
index b4e04a9fa260,2f8e8ff2d000..000000000000
--- a/arch/x86/kernel/cpu/amd.c
+++ b/arch/x86/kernel/cpu/amd.c
@@@ -1074,16 -974,84 +1074,91 @@@ static void zenbleed_check(struct cpuin
  	}
