	Tested-by: Vitaly Prosyak <vitaly.prosyak@amd.com>
	Reviewed-by: Alex Deucher <alexander.deucher@amd.com>
	Signed-off-by: Alex Deucher <alexander.deucher@amd.com>
(cherry picked from commit c08972f555945cda57b0adb72272a37910153390)
	Cc: stable@vger.kernel.org
(cherry picked from commit 962d684b5dc0741dcd93485d41b450de402d5592)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	drivers/gpu/drm/amd/amdgpu/amdgpu_hmm.c
diff --cc drivers/gpu/drm/amd/amdgpu/amdgpu_hmm.c
index 6e9fa23f1f17,0a9582da3a33..000000000000
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_hmm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_hmm.c
@@@ -167,19 -165,16 +165,30 @@@ void amdgpu_hmm_unregister(struct amdgp
  
  int amdgpu_hmm_range_get_pages(struct mmu_interval_notifier *notifier,
  			       uint64_t start, uint64_t npages, bool readonly,
 -			       void *owner,
 -			       struct amdgpu_hmm_range *range)
 +			       void *owner, struct page **pages,
 +			       struct hmm_range **phmm_range)
  {
++<<<<<<< HEAD
 +	struct hmm_range *hmm_range;
 +	unsigned long end;
++=======
+ 	const u64 max_bytes = SZ_2G;
+ 
+ 	struct hmm_range *hmm_range = &range->hmm_range;
++>>>>>>> 962d684b5dc0 (drm/amdgpu: fix amdgpu_hmm_range_get_pages)
  	unsigned long timeout;
 +	unsigned long i;
  	unsigned long *pfns;
++<<<<<<< HEAD
 +	int r = 0;
 +
 +	hmm_range = kzalloc(sizeof(*hmm_range), GFP_KERNEL);
 +	if (unlikely(!hmm_range))
 +		return -ENOMEM;
++=======
+ 	unsigned long end;
+ 	int r;
++>>>>>>> 962d684b5dc0 (drm/amdgpu: fix amdgpu_hmm_range_get_pages)
  
  	pfns = kvmalloc_array(npages, sizeof(*pfns), GFP_KERNEL);
  	if (unlikely(!pfns)) {
@@@ -202,19 -198,11 +212,18 @@@
  		pr_debug("hmm range: start = 0x%lx, end = 0x%lx",
  			hmm_range->start, hmm_range->end);
  
 -		timeout = jiffies + msecs_to_jiffies(HMM_RANGE_DEFAULT_TIMEOUT);
 +		/* Assuming 512MB takes maxmium 1 second to fault page address */
 +		timeout = max((hmm_range->end - hmm_range->start) >> 29, 1UL);
 +		timeout *= HMM_RANGE_DEFAULT_TIMEOUT;
 +		timeout = jiffies + msecs_to_jiffies(timeout);
  
  retry:
- 		hmm_range->notifier_seq = mmu_interval_read_begin(notifier);
  		r = hmm_range_fault(hmm_range);
  		if (unlikely(r)) {
 +			/*
 +			 * FIXME: This timeout should encompass the retry from
 +			 * mmu_interval_read_retry() as well.
 +			 */
  			if (r == -EBUSY && !time_after(jiffies, timeout))
  				goto retry;
  			goto out_free_pfns;
@@@ -222,9 -210,8 +231,9 @@@
  
  		if (hmm_range->end == end)
  			break;
- 		hmm_range->hmm_pfns += MAX_WALK_BYTE >> PAGE_SHIFT;
+ 		hmm_range->hmm_pfns += max_bytes >> PAGE_SHIFT;
  		hmm_range->start = hmm_range->end;
 +		schedule();
  	} while (hmm_range->end < end);
  
  	hmm_range->start = start;
