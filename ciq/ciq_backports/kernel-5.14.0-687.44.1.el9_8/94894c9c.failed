diff --cc kernel/sched/rt.c
index 57448de051e0,a7680477fa6f..000000000000
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@@ -2181,11 -2130,12 +2182,19 @@@ static int rto_next_cpu(struct root_dom
  
  		rd->rto_cpu = cpu;
  
++<<<<<<< HEAD
 +		if (cpu < nr_cpu_ids) {
 +			if (!has_pushable_tasks(cpu_rq(cpu)))
 +				continue;
++=======
+ 		/* Do not send IPI to self */
+ 		if (cpu == this_cpu)
+ 			continue;
+ 
+ 		if (cpu < nr_cpu_ids)
++>>>>>>> 94894c9c477e (sched/rt: Skip currently executing CPU in rto_next_cpu())
  			return cpu;
 +		}
  
  		rd->rto_cpu = -1;
  
