+ 		}
+ 
+ 		if (ops->peer_type) {
+ 			ret = rtnl_add_peer_net(&rtnl_nets, ops, data, extack);
+ 			if (ret < 0)
+ 				goto put_ops;
+ 		}
+ 	}
+ 
+ 	tgt_net = rtnl_link_get_net_capable(skb, sock_net(skb->sk), tb, CAP_NET_ADMIN);
