+ 	}
+ 
+ 	rtnl_nets_add(&rtnl_nets, tgt_net);
+ 
+ 	if (tb[IFLA_LINK_NETNSID]) {
+ 		int id = nla_get_s32(tb[IFLA_LINK_NETNSID]);
+ 
+ 		link_net = get_net_ns_by_id(tgt_net, id);
