+++ b/net/ipv4/fib_frontend.c
@@@ -997,15 -1035,14 +997,23 @@@ static int inet_dump_fib(struct sk_buf
  	struct fib_dump_filter filter = {
  		.dump_routes = true,
  		.dump_exceptions = true,
 +		.rtnl_held = false,
  	};
++<<<<<<< HEAD
 +	const struct nlmsghdr *nlh = cb->nlh;
 +	struct net *net = sock_net(skb->sk);
 +	unsigned int h, s_h;
 +	unsigned int e = 0, s_e;
 +	struct fib_table *tb;
 +	struct hlist_head *head;
 +	int dumped = 0, err = 0;
++=======
+ 	struct hlist_head *head;
+ 	int dumped = 0, err = 0;
+ 	struct fib_table *tb;
+ 	unsigned int h, s_h;
+ 	u32 s_id;
++>>>>>>> 2ed8d5c72488 (ipv4: fib: fix route re-dump in inet_dump_fib() on multi-batch dump)
  
  	rcu_read_lock();
  	if (cb->strict_check) {
* Unmerged path net/ipv4/fib_frontend.c
