fs: factor out backing_file_mmap() helper

jira KERNEL-1233
cve CVE-2026-46054
Rebuild_History Non-Buildable kernel-5.14.0-687.20.1.el9_8
commit-author Amir Goldstein <amir73il@gmail.com>
commit f567377e406c032fff0799bde4fdf4a977529b84
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-5.14.0-687.20.1.el9_8/f567377e.failed

Assert that the file object is allocated in a backing_file container
so that file_user_path() could be used to display the user path and
not the backing file's path in /proc/<pid>/maps.

	Signed-off-by: Amir Goldstein <amir73il@gmail.com>
(cherry picked from commit f567377e406c032fff0799bde4fdf4a977529b84)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	fs/backing-file.c
#	include/linux/backing-file.h
* Unmerged path fs/backing-file.c
* Unmerged path include/linux/backing-file.h
* Unmerged path fs/backing-file.c
diff --git a/fs/overlayfs/file.c b/fs/overlayfs/file.c
index 329ff9aac5c4..49b6a56067e4 100644
--- a/fs/overlayfs/file.c
+++ b/fs/overlayfs/file.c
@@ -11,7 +11,6 @@
 #include <linux/uaccess.h>
 #include <linux/splice.h>
 #include <linux/security.h>
-#include <linux/mm.h>
 #include <linux/fs.h>
 #include "overlayfs.h"
 
@@ -565,23 +564,13 @@ static int ovl_fsync(struct file *file, loff_t start, loff_t end, int datasync)
 static int ovl_mmap(struct file *file, struct vm_area_struct *vma)
 {
 	struct file *realfile = file->private_data;
-	const struct cred *old_cred;
-	int ret;
-
-	if (!realfile->f_op->mmap)
-		return -ENODEV;
-
-	if (WARN_ON(file != vma->vm_file))
-		return -EIO;
-
-	vma_set_file(vma, realfile);
+	struct backing_file_ctx ctx = {
+		.cred = ovl_creds(file_inode(file)->i_sb),
+		.user_file = file,
+		.accessed = ovl_file_accessed,
+	};
 
-	old_cred = ovl_override_creds(file_inode(file)->i_sb);
-	ret = call_mmap(vma->vm_file, vma);
-	revert_creds(old_cred);
-	ovl_file_accessed(file);
-
-	return ret;
+	return backing_file_mmap(realfile, vma, &ctx);
 }
 
 static long ovl_fallocate(struct file *file, int mode, loff_t offset, loff_t len)
* Unmerged path include/linux/backing-file.h
