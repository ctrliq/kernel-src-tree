+ 	netif_napi_set_irq_locked(&c->napi, irq);
++>>>>>>> 673d7ab7563e (net/mlx5e: Prepare for using multiple TX doorbells)
  
  	err = mlx5e_open_queues(c, params, cparam);
  	if (unlikely(err))
