diff --cc arch/s390/include/asm/word-at-a-time.h
index 203acd6e431b,e9287036392d..000000000000
--- a/arch/s390/include/asm/word-at-a-time.h
+++ b/arch/s390/include/asm/word-at-a-time.h
@@@ -41,25 -40,4 +40,28 @@@ static inline unsigned long zero_bytema
  	return ~1UL << data;
