+ #if IS_ENABLED(CONFIG_PSAMPLE)
+ static void execute_psample(struct datapath *dp, struct sk_buff *skb,
+ 			    const struct nlattr *attr)
+ {
+ 	struct psample_group psample_group = {};
+ 	struct psample_metadata md = {};
+ 	const struct nlattr *a;
+ 	u32 rate;
+ 	int rem;
