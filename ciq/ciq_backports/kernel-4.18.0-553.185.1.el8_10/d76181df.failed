+ static void modify_fac_list(char *str)
+ {
+ 	unsigned long val, endval;
+ 	char *endp;
+ 	bool clear;
+ 
+ 	while (*str) {
+ 		clear = false;
+ 		if (*str == '!') {
+ 			clear = true;
+ 			str++;
+ 		}
+ 		val = simple_strtoull(str, &endp, 0);
+ 		if (str == endp)
+ 			break;
+ 		str = endp;
+ 		if (*str == '-') {
+ 			str++;
+ 			endval = simple_strtoull(str, &endp, 0);
+ 			if (str == endp)
+ 				break;
+ 			str = endp;
+ 			while (val <= endval) {
+ 				modify_facility(val, clear);
+ 				val++;
+ 			}
+ 		} else {
+ 			modify_facility(val, clear);
+ 		}
+ 		if (*str != ',')
+ 			break;
+ 		str++;
+ 	}
+ 	check_cleared_facilities();
+ }
