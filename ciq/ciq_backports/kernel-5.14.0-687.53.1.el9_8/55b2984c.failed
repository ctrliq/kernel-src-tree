  		goto out;
  	}
  
 -	do {
 -		skb = __skb_dequeue(&call->rx_queue);
 -		if (skb) {
 -			struct rxrpc_skb_priv *sp = rxrpc_skb(skb);
 +	if (skb && skb->mark == RXRPC_SKB_MARK_ERROR)
 +		goto out;
  
