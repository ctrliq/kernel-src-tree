  static struct mount *next_mnt(struct mount *p, struct mount *root)
@@@ -1554,10 -1803,10 +1569,10 @@@ static void umount_tree(struct mount *m
  		list_del_init(&p->mnt_list);
  		ns = p->mnt_ns;
  		if (ns) {
 -			ns->nr_mounts--;
 +			ns->mounts--;
  			__touch_mnt_namespace(ns);
