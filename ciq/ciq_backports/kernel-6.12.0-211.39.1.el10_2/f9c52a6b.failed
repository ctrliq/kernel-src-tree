 +		if (!dst->error) {
++=======
+ 		if (unlikely(!dst)) {
+ 			err = -ENETUNREACH;
+ 			goto drop;
+ 		}
+ 
+ 		/* cache only if we don't create a dst reference loop */
+ 		if (!dst->error && lwtst != dst->lwtstate) {
++>>>>>>> f9c52a6ba978 (net: ipv6: fix NOREF dst use in seg6 and rpl lwtunnels)
  			local_bh_disable();
  			dst_cache_set_ip6(&rlwt->cache, dst,
  					  &ipv6_hdr(skb)->saddr);
* Unmerged path net/ipv6/rpl_iptunnel.c
diff --git a/net/ipv6/seg6_iptunnel.c b/net/ipv6/seg6_iptunnel.c
index 3e1b9991131a..13ef405f4611 100644
--- a/net/ipv6/seg6_iptunnel.c
+++ b/net/ipv6/seg6_iptunnel.c
@@ -499,7 +499,16 @@ static int seg6_input_core(struct net *net, struct sock *sk,
 
 	if (!dst) {
 		ip6_route_input(skb);
+
+		/* ip6_route_input() sets a NOREF dst; force a refcount on it
+		 * before caching or further use.
+		 */
+		skb_dst_force(skb);
 		dst = skb_dst(skb);
+		if (unlikely(!dst)) {
+			err = -ENETUNREACH;
+			goto drop;
+		}
 
 		/* cache only if we don't create a dst reference loop */
 		if (!dst->error && lwtst != dst->lwtstate) {
