# Conflicts:
#	net/ipv6/rpl_iptunnel.c
diff --cc net/ipv6/rpl_iptunnel.c
index f264c0b1f45d,4e10adcd70e8..000000000000
--- a/net/ipv6/rpl_iptunnel.c
+++ b/net/ipv6/rpl_iptunnel.c
@@@ -279,8 -287,19 +279,23 @@@ static int rpl_input(struct sk_buff *sk
  
  	if (!dst) {
  		ip6_route_input(skb);
+ 
+ 		/* ip6_route_input() sets a NOREF dst; force a refcount on it
+ 		 * before caching or further use.
+ 		 */
+ 		skb_dst_force(skb);
  		dst = skb_dst(skb);
