+ 
+ 	f = alloc_empty_backing_file(flags, cred);
+ 	if (IS_ERR(f))
+ 		return f;
+ 
+ 	f->f_path = *path;
+ 	path_get(real_path);
+ 	*backing_file_real_path(f) = *real_path;
+ 	error = do_dentry_open(f, d_inode(real_path->dentry), NULL);
+ 	if (error) {
+ 		fput(f);
+ 		f = ERR_PTR(error);
+ 	}
+ 
+ 	return f;
+ }
+ EXPORT_SYMBOL_GPL(backing_file_open);
  
