 +			(char *)&keepidle, sizeof(keepidle));
 +	kernel_setsockopt(sock, SOL_TCP, TCP_KEEPCNT,
 +			(char *)&keepcnt, sizeof(keepcnt));
  
  	/* TCP user timeout (see RFC5482) */
