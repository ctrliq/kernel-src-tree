# Conflicts:
#	kernel/sched/deadline.c
#	kernel/sched/rt.c
diff --cc kernel/sched/deadline.c
index 111afb0cb34e,0663c00c41c0..000000000000
--- a/kernel/sched/deadline.c
+++ b/kernel/sched/deadline.c
@@@ -2313,6 -3017,39 +2313,42 @@@ static int find_later_rq(struct task_st
  	return -1;
  }
  
++<<<<<<< HEAD
++=======
+ static struct task_struct *pick_next_pushable_dl_task(struct rq *rq)
+ {
+ 	struct task_struct *i, *p = NULL;
+ 	struct rb_node *next_node;
+ 
+ 	if (!has_pushable_dl_tasks(rq))
+ 		return NULL;
+ 
+ 	next_node = rb_first_cached(&rq->dl.pushable_dl_tasks_root);
+ 	while (next_node) {
+ 		i = __node_2_pdl(next_node);
+ 		/* skip tasks that cannot be migrated */
+ 		if (!task_on_cpu(rq, i) && !is_migration_disabled(i)) {
+ 			p = i;
+ 			break;
+ 		}
+ 
+ 		next_node = rb_next(next_node);
+ 	}
+ 
+ 	if (!p)
+ 		return NULL;
+ 
+ 	WARN_ON_ONCE(rq->cpu != task_cpu(p));
+ 	WARN_ON_ONCE(task_current(rq, p));
+ 	WARN_ON_ONCE(p->nr_cpus_allowed <= 1);
+ 
+ 	WARN_ON_ONCE(!task_on_rq_queued(p));
+ 	WARN_ON_ONCE(!dl_task(p));
+ 
+ 	return p;
+ }
+ 
++>>>>>>> dae5c0292080 (sched/rt,dl: Skip migrate-disabled tasks when picking a push candidate)
  /* Locks the rq it finds */
  static struct rq *find_lock_later_rq(struct task_struct *task, struct rq *rq)
  {
