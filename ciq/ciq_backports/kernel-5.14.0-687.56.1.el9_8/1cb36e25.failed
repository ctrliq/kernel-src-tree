@@@ -85,9 -85,7 +86,12 @@@ static int virtio_transport_init_zcopy_
  		struct ubuf_info_msgzc *uarg_zc;
  
  		uarg = msg_zerocopy_realloc(sk_vsock(vsk),
++<<<<<<< HEAD
 +					    iter->count,
 +					    NULL);
++=======
+ 					    pkt_len, NULL, false);
++>>>>>>> 1cb36e252211 (vsock/virtio: fix MSG_ZEROCOPY pinned-pages accounting)
  		if (!uarg)
  			return -1;
  
