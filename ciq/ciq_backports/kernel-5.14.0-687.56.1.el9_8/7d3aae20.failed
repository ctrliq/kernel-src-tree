# Conflicts:
#	arch/x86/kvm/svm/avic.c
diff --cc arch/x86/kvm/svm/avic.c
index 65fd245a9953,16e09a8fe85e..000000000000
--- a/arch/x86/kvm/svm/avic.c
+++ b/arch/x86/kvm/svm/avic.c
@@@ -124,16 -237,11 +124,21 @@@ static void avic_deactivate_vmcb(struc
  	vmcb->control.int_ctl &= ~(AVIC_ENABLE_MASK | X2APIC_MODE_MASK);
  	vmcb->control.avic_physical_id &= ~AVIC_PHYSICAL_MAX_INDEX_MASK;
  
++<<<<<<< HEAD
 +	/*
 +	 * If running nested and the guest uses its own MSR bitmap, there
 +	 * is no need to update L0's msr bitmap
 +	 */
 +	if (is_guest_mode(&svm->vcpu) &&
 +	    vmcb12_is_intercept(&svm->nested.ctl, INTERCEPT_MSR_PROT))
 +		return;
++=======
+ 	if (!is_sev_es_guest(&svm->vcpu))
+ 		svm_set_intercept(svm, INTERCEPT_CR8_WRITE);
++>>>>>>> 7d3aae206663 (KVM: SVM: Update x2APIC MSR intercepts if AVIC is inhibited while L2 is active)
  
  	/* Enabling MSR intercept for x2APIC registers */
 -	avic_set_x2apic_msr_interception(svm, true);
 +	svm_set_x2apic_msr_interception(svm, true);
  }
  
  /* Note:
* Unmerged path arch/x86/kvm/svm/avic.c
