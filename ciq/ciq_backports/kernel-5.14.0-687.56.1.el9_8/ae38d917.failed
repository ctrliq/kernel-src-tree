  static int virtio_transport_fill_skb(struct sk_buff *skb,
  				     struct virtio_vsock_pkt_info *info,
  				     size_t len,
@@@ -393,21 -371,7 +417,25 @@@ static int virtio_transport_send_pkt_in
  			break;
  		}
  
