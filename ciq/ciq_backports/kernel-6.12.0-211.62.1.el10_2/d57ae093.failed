 +static void gve_unreg_xdp_info(struct gve_priv *priv)
 +{
 +	int i, tx_qid;
 +
 +	if (!priv->num_xdp_queues)
 +		return;
 +
 +	for (i = 0; i < priv->rx_cfg.num_queues; i++) {
 +		struct gve_rx_ring *rx = &priv->rx[i];
 +
 +		xdp_rxq_info_unreg(&rx->xdp_rxq);
 +		if (rx->xsk_pool) {
 +			xdp_rxq_info_unreg(&rx->xsk_rxq);
 +			rx->xsk_pool = NULL;
 +		}
 +	}
