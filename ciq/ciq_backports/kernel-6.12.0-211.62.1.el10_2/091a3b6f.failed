+ 	if (dev->mtu > max_xdp_mtu) {
+ 		NL_SET_ERR_MSG_FMT_MOD(extack,
+ 				       "XDP is not supported for mtu %d.",
+ 				       dev->mtu);
++>>>>>>> 091a3b6ff2b9 (gve: Use extack to log xdp config verification errors)
