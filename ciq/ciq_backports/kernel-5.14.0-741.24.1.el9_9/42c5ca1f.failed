# Conflicts:
#	kernel/events/core.c
diff --cc kernel/events/core.c
index 2a3fe26b7932,1a73ba0747df..000000000000
--- a/kernel/events/core.c
+++ b/kernel/events/core.c
@@@ -2434,9 -2596,15 +2445,16 @@@ __perf_remove_from_context(struct perf_
  	 * Ensure event_sched_out() switches to OFF, at the very least
  	 * this avoids raising perf_pending_task() at this time.
  	 */
 -	if (flags & DETACH_EXIT)
 -		state = PERF_EVENT_STATE_EXIT;
 -	if (flags & DETACH_REVOKE)
 -		state = PERF_EVENT_STATE_REVOKED;
  	if (flags & DETACH_DEAD)
++<<<<<<< HEAD
 +		event->pending_disable = 1;
 +	event_sched_out(event, ctx);
++=======
+ 		state = PERF_EVENT_STATE_DEAD;
+ 
+ 	__event_disable(event, ctx, state);
+ 
++>>>>>>> 42c5ca1f0a28 (perf/core: Fix group leader use-after-free after sibling detach)
  	if (flags & DETACH_GROUP)
  		perf_group_detach(event);
  	if (flags & DETACH_CHILD)
* Unmerged path kernel/events/core.c
