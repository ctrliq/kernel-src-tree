++<<<<<<< HEAD
 +	/*
 +	 * SEAL_EXEC implys SEAL_WRITE, making W^X from the start.
 +	 */
 +	if (seals & F_SEAL_EXEC && inode->i_mode & 0111)
 +		seals |= F_SEAL_SHRINK|F_SEAL_GROW|F_SEAL_WRITE|F_SEAL_FUTURE_WRITE;
 +
