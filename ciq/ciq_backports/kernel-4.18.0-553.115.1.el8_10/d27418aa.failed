diff --cc drivers/scsi/st.c
index f77d41bb72a8,168f25e4aaa3..000000000000
--- a/drivers/scsi/st.c
+++ b/drivers/scsi/st.c
@@@ -3528,8 -3526,64 +3528,68 @@@ static int partition_tape(struct scsi_t
  out:
  	return result;
  }
 +
  
++<<<<<<< HEAD
++=======
+ /*
+  * Handles any extra state needed for ioctls which are not st-specific.
+  * Called with the scsi_tape lock held, released before return
+  */
+ static long st_common_ioctl(struct scsi_tape *STp, struct st_modedef *STm,
+ 			    struct file *file, unsigned int cmd_in,
+ 			    unsigned long arg)
+ {
+ 	int i, retval = 0;
+ 
+ 	if (!STm->defined) {
+ 		retval = -ENXIO;
+ 		goto out;
+ 	}
+ 
+ 	switch (cmd_in) {
+ 	case SCSI_IOCTL_GET_IDLUN:
+ 	case SCSI_IOCTL_GET_BUS_NUMBER:
+ 	case SCSI_IOCTL_GET_PCI:
+ 		break;
+ 	case SG_IO:
+ 	case SCSI_IOCTL_SEND_COMMAND:
+ 	case CDROM_SEND_PACKET:
+ 		if (!capable(CAP_SYS_RAWIO)) {
+ 			retval = -EPERM;
+ 			goto out;
+ 		}
+ 		fallthrough;
+ 	default:
+ 		if ((i = flush_buffer(STp, 0)) < 0) {
+ 			retval = i;
+ 			goto out;
+ 		} else { /* flush_buffer succeeds */
+ 			if (STp->can_partitions) {
+ 				i = switch_partition(STp);
+ 				if (i < 0) {
+ 					retval = i;
+ 					goto out;
+ 				}
+ 			}
+ 		}
+ 	}
+ 	mutex_unlock(&STp->lock);
+ 
+ 	retval = scsi_ioctl(STp->device, file->f_mode & FMODE_WRITE,
+ 			    cmd_in, (void __user *)arg);
+ 	if (!retval && cmd_in == SCSI_IOCTL_STOP_UNIT) {
+ 		/* unload */
+ 		STp->rew_at_close = 0;
+ 		STp->ready = ST_NO_TAPE;
+ 	}
+ 
+ 	return retval;
+ out:
+ 	mutex_unlock(&STp->lock);
+ 	return retval;
+ }
++>>>>>>> d27418aaf8bc (scsi: st: Skip buffer flush for information ioctls)
  
