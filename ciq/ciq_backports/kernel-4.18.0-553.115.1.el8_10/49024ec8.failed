+	int rc;
 
 	if (unlikely(!devname || !*devname)) {
 		cifs_dbg(VFS, "Device name not specified\n");
@@ -519,6 +554,8 @@ smb3_parse_devname(const char *devname, struct smb3_fs_context *ctx)
 
