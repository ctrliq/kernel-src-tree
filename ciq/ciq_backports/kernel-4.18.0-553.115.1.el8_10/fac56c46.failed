+ 	if (IS_ERR(path)) {
+ 		rc = PTR_ERR(path);
+ 		goto out;
+ 	}
+ 
+ 	ses = CIFS_DFS_ROOT_SES(ses);
+ 	if (!is_ses_good(tcon, ses)) {
+ 		cifs_dbg(FYI, "%s: skip cache refresh due to disconnected ipc\n",
+ 			 __func__);
+ 		goto out;
+ 	}
+ 
+ 	ce = cache_refresh_path(xid, ses, path, false);
+ 	if (!IS_ERR(ce))
+ 		up_read(&htable_rw_lock);
+ 	else
+ 		rc = PTR_ERR(ce);
+ 
+ out:
+ 	free_xid(xid);
+ }
