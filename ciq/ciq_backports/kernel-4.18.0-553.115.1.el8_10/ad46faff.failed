+ static inline bool cifs_netbios_name(const char *name, size_t namelen)
+ {
+ 	bool ret = false;
+ 	size_t i;
+ 
+ 	if (namelen >= 1 && namelen <= RFC1001_NAME_LEN) {
+ 		for (i = 0; i < namelen; i++) {
+ 			const unsigned char c = name[i];
+ 
+ 			if (c == '\\' || c == '/' || c == ':' || c == '*' ||
+ 			    c == '?' || c == '"' || c == '<' || c == '>' ||
+ 			    c == '|' || c == '.')
+ 				return false;
+ 			if (!ret && isalpha(c))
+ 				ret = true;
+ 		}
+ 	}
+ 	return ret;
+ }
+ 
  #endif	/* _CIFS_GLOB_H */
