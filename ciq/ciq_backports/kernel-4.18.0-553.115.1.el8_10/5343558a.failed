 -	}
 -
 -	if (x86_family(bsp_cpuid_1_eax) < 0x17) {
 -		equiv_id = find_equiv_id(&equiv_table, uci->cpu_sig.sig);
 -		if (!equiv_id)
 -			return NULL;
 -	}
 +	equiv_id = __find_equiv_id(cpu);
 +	if (!equiv_id)
 +		return NULL;
  
 -	return cache_find_patch(uci, equiv_id);
 +	return cache_find_patch(equiv_id);
