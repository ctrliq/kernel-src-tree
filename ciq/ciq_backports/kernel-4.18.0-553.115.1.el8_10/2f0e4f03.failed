diff --cc fs/cifs/file.c
index 0580416165b8,6831a9949c43..000000000000
--- a/fs/cifs/file.c
+++ b/fs/cifs/file.c
@@@ -31,6 -34,174 +31,177 @@@
  #include "fscache.h"
