diff --cc fs/cifs/dns_resolve.h
index afc0df381246,0dc706f2c422..000000000000
--- a/fs/cifs/dns_resolve.h
+++ b/fs/cifs/dns_resolve.h
@@@ -11,8 -11,31 +11,36 @@@
  #ifndef _DNS_RESOLVE_H
  #define _DNS_RESOLVE_H
  
++<<<<<<< HEAD:fs/cifs/dns_resolve.h
 +#ifdef __KERNEL__
 +extern int dns_resolve_server_name_to_ip(const char *unc, char **ip_addr, time64_t *expiry);
++=======
+ #include <linux/net.h>
+ #include "cifsglob.h"
+ #include "cifsproto.h"
+ 
+ #ifdef __KERNEL__
+ 
+ int dns_resolve_name(const char *dom, const char *name,
+ 		     size_t namelen, struct sockaddr *ip_addr);
+ 
+ static inline int dns_resolve_unc(const char *dom, const char *unc,
+ 				  struct sockaddr *ip_addr)
+ {
+ 	const char *name;
+ 	size_t namelen;
+ 
+ 	if (!unc || strlen(unc) < 3)
+ 		return -EINVAL;
+ 
+ 	extract_unc_hostname(unc, &name, &namelen);
+ 	if (!namelen)
+ 		return -EINVAL;
+ 
+ 	return dns_resolve_name(dom, name, namelen, ip_addr);
+ }
+ 
++>>>>>>> 4b1b4c8be9de (smb: client: provide dns_resolve_{unc,name} helpers):fs/smb/client/dns_resolve.h
  #endif /* KERNEL */
  
  #endif /* _DNS_RESOLVE_H */
