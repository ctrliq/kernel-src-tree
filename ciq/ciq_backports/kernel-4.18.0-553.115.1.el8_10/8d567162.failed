 +	if (unlikely(ret))
 +		return EVICT_SHOULD_SKIP_DELETE;
  
  	if (gfs2_inode_already_deleted(ip->i_gl, ip->i_no_formal_ino))
 -		return SHOULD_NOT_DELETE_DINODE;
 +		return EVICT_SHOULD_SKIP_DELETE;
  	ret = gfs2_check_blk_type(sdp, ip->i_no_addr, GFS2_BLKST_UNLINKED);
  	if (ret)
 -		return SHOULD_NOT_DELETE_DINODE;
 +		return EVICT_SHOULD_SKIP_DELETE;
  
