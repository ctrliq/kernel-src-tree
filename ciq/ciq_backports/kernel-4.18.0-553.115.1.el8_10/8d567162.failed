+++ b/fs/gfs2/super.c
@@@ -1292,20 -1231,22 +1292,26 @@@ static enum evict_behavior evict_should
  
  	/* Must not read inode block until block type has been verified */
  	ret = gfs2_glock_nq_init(ip->i_gl, LM_ST_EXCLUSIVE, GL_SKIP, gh);
