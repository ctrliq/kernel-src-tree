+ 
+ 	shinfo = skb_shinfo(skb);
+ 
+ 	if (shinfo->nr_frags > 0) {
+ 		niov = netmem_to_net_iov(skb_frag_netmem(&shinfo->frags[0]));
+ 		if (net_is_devmem_iov(niov) &&
+ 		    READ_ONCE(net_devmem_iov_binding(niov)->dev) != dev)
+ 			goto out_free;
+ 	}
+ 
+ out:
+ 	return skb;
+ 
+ out_free:
+ 	kfree_skb(skb);
+ 	return NULL;
+ }
