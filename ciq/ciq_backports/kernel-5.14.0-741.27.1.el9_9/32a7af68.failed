diff --cc fs/smb/client/inode.c
index 9d6a943fbd12,098d5496e779..000000000000
--- a/fs/smb/client/inode.c
+++ b/fs/smb/client/inode.c
@@@ -3050,6 -3058,24 +3050,27 @@@ void cifs_setsize(struct inode *inode, 
  	spin_unlock(&inode->i_lock);
  	inode_set_mtime_to_ts(inode, inode_set_ctime_current(inode));
  	truncate_pagecache(inode, offset);
++<<<<<<< HEAD
++=======
+ 	netfs_wait_for_outstanding_io(inode);
+ }
+ 
+ void cifs_resize_file_locked(struct inode *inode, loff_t offset)
+ {
+ 	struct fscache_cookie *cookie = cifs_inode_cookie(inode);
+ 
+ 	lockdep_assert_held_write(&inode->i_rwsem);
+ 
+ 	netfs_resize_file(netfs_inode(inode), offset, true);
+ 	cifs_setsize(inode, offset);
+ 
+ 	if (!cookie)
+ 		return;
+ 
+ 	fscache_use_cookie(cookie, true);
+ 	fscache_resize_cookie(cookie, offset);
+ 	cifs_fscache_unuse_inode_cookie(inode, true);
++>>>>>>> 32a7af68df73 (cifs: add cifs_resize_file_locked() to guard fscache_resize_cookie() under i_rwsem)
  }
  
  int cifs_file_set_size(const unsigned int xid, struct dentry *dentry,
@@@ -3115,10 -3141,8 +3136,15 @@@
  	cifs_put_tlink(tlink);
  
  set_size_out:
++<<<<<<< HEAD
 +	if (rc == 0) {
 +		netfs_resize_file(&cifsInode->netfs, size);
 +		cifs_setsize(inode, size);
 +	}
++=======
+ 	if (rc == 0)
+ 		cifs_resize_file_locked(inode, size);
++>>>>>>> 32a7af68df73 (cifs: add cifs_resize_file_locked() to guard fscache_resize_cookie() under i_rwsem)
  
  	return rc;
  }
