 +		/* prevent more writes to the journal */
 +		clear_bit(SDF_JOURNAL_LIVE, &sdp->sd_flags);
 +		wake_up(&sdp->sd_logd_waitq);
++=======
+ 		gfs2_withdraw(sdp);
++>>>>>>> 83348905e413 (gfs2: Clean up SDF_JOURNAL_LIVE flag handling)
