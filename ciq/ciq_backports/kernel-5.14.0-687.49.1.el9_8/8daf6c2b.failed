  	/* number of revokes we still have room for */
  	unsigned int max_revokes = atomic_read(&sdp->sd_log_revokes_available);
  
 -	gfs2_log_lock(sdp);
 +	spin_lock(&sdp->sd_log_lock);
  	gfs2_ail1_empty(sdp, max_revokes);
++<<<<<<< HEAD
