diff --cc fs/gfs2/sys.c
index 072b81e9b940,5439a65549af..000000000000
--- a/fs/gfs2/sys.c
+++ b/fs/gfs2/sys.c
@@@ -187,8 -191,8 +187,13 @@@ static ssize_t freeze_store(struct gfs2
  
  static ssize_t withdraw_show(struct gfs2_sbd *sdp, char *buf)
  {
++<<<<<<< HEAD
 +	unsigned int b = gfs2_withdrawing_or_withdrawn(sdp);
 +	return snprintf(buf, PAGE_SIZE, "%u\n", b);
++=======
+ 	unsigned int b = gfs2_withdrawn(sdp);
+ 	return sysfs_emit(buf, "%u\n", b);
++>>>>>>> 1b7d498dcab4 (gfs2: Rename gfs2_{withdrawing_or_ => }withdrawn)
