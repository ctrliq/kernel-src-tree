dpll: add dpll_device op to set working mode

jira KERNEL-755
Rebuild_History Non-Buildable kernel-6.12.0-124.45.1.el10_1
commit-author Ivan Vecera <ivecera@redhat.com>
commit e3f6c65192fe484ab16f0be2b495ceef5ca3b85c
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-6.12.0-124.45.1.el10_1/e3f6c651.failed

Currently, userspace can retrieve the DPLL working mode but cannot
configure it. This prevents changing the device operation, such as
switching from manual to automatic mode and vice versa.

Add a new callback .mode_set() to struct dpll_device_ops. Extend
the netlink policy and device-set command handling to process
the DPLL_A_MODE attribute.  Update the netlink YAML specification
to include the mode attribute in the device-set operation.

	Reviewed-by: Vadim Fedorenko <vadim.fedorenko@linux.dev>
	Signed-off-by: Ivan Vecera <ivecera@redhat.com>
Link: https://patch.msgid.link/20260114122726.120303-3-ivecera@redhat.com
	Signed-off-by: Jakub Kicinski <kuba@kernel.org>
(cherry picked from commit e3f6c65192fe484ab16f0be2b495ceef5ca3b85c)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	drivers/dpll/dpll_netlink.c
diff --cc drivers/dpll/dpll_netlink.c
index 8176c8fe1c61,499bca460b1e..000000000000
--- a/drivers/dpll/dpll_netlink.c
+++ b/drivers/dpll/dpll_netlink.c
@@@ -1609,14 -1841,30 +1648,38 @@@ int dpll_nl_device_get_doit(struct sk_b
  static int
  dpll_set_from_nlattr(struct dpll_device *dpll, struct genl_info *info)
  {
 -	struct nlattr *a;
 -	int rem, ret;
 +	int ret;
 +
++<<<<<<< HEAD
 +	if (info->attrs[DPLL_A_PHASE_OFFSET_MONITOR]) {
 +		struct nlattr *a = info->attrs[DPLL_A_PHASE_OFFSET_MONITOR];
  
 +		ret = dpll_phase_offset_monitor_set(dpll, a, info->extack);
 +		if (ret)
 +			return ret;
++=======
+ 	nla_for_each_attr(a, genlmsg_data(info->genlhdr),
+ 			  genlmsg_len(info->genlhdr), rem) {
+ 		switch (nla_type(a)) {
+ 		case DPLL_A_MODE:
+ 			ret = dpll_mode_set(dpll, a, info->extack);
+ 			if (ret)
+ 				return ret;
+ 			break;
+ 		case DPLL_A_PHASE_OFFSET_MONITOR:
+ 			ret = dpll_phase_offset_monitor_set(dpll, a,
+ 							    info->extack);
+ 			if (ret)
+ 				return ret;
+ 			break;
+ 		case DPLL_A_PHASE_OFFSET_AVG_FACTOR:
+ 			ret = dpll_phase_offset_avg_factor_set(dpll, a,
+ 							       info->extack);
+ 			if (ret)
+ 				return ret;
+ 			break;
+ 		}
++>>>>>>> e3f6c65192fe (dpll: add dpll_device op to set working mode)
  	}
  
  	return 0;
diff --git a/Documentation/netlink/specs/dpll.yaml b/Documentation/netlink/specs/dpll.yaml
index 50188eb74e04..a833d48e0903 100644
--- a/Documentation/netlink/specs/dpll.yaml
+++ b/Documentation/netlink/specs/dpll.yaml
@@ -550,6 +550,7 @@ operations:
         request:
           attributes:
             - id
+            - mode
             - phase-offset-monitor
             - phase-offset-avg-factor
     -
* Unmerged path drivers/dpll/dpll_netlink.c
diff --git a/drivers/dpll/dpll_nl.c b/drivers/dpll/dpll_nl.c
index 3c6d570babf8..3fb64aab18fa 100644
--- a/drivers/dpll/dpll_nl.c
+++ b/drivers/dpll/dpll_nl.c
@@ -44,6 +44,7 @@ static const struct nla_policy dpll_device_get_nl_policy[DPLL_A_ID + 1] = {
 /* DPLL_CMD_DEVICE_SET - do */
 static const struct nla_policy dpll_device_set_nl_policy[DPLL_A_PHASE_OFFSET_AVG_FACTOR + 1] = {
 	[DPLL_A_ID] = { .type = NLA_U32, },
+	[DPLL_A_MODE] = NLA_POLICY_RANGE(NLA_U32, 1, 2),
 	[DPLL_A_PHASE_OFFSET_MONITOR] = NLA_POLICY_MAX(NLA_U32, 1),
 	[DPLL_A_PHASE_OFFSET_AVG_FACTOR] = { .type = NLA_U32, },
 };
diff --git a/include/linux/dpll.h b/include/linux/dpll.h
index 39398ca59f7a..12f40f5d8f4a 100644
--- a/include/linux/dpll.h
+++ b/include/linux/dpll.h
@@ -22,6 +22,8 @@ struct dpll_pin_esync;
 struct dpll_device_ops {
 	int (*mode_get)(const struct dpll_device *dpll, void *dpll_priv,
 			enum dpll_mode *mode, struct netlink_ext_ack *extack);
+	int (*mode_set)(const struct dpll_device *dpll, void *dpll_priv,
+			enum dpll_mode mode, struct netlink_ext_ack *extack);
 	int (*supported_modes_get)(const struct dpll_device *dpll,
 				   void *dpll_priv, unsigned long *modes,
 				   struct netlink_ext_ack *extack);
