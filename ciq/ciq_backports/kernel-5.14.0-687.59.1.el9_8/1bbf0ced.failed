index b1a3eb9c47d7,98848db62894..000000000000
--- a/include/net/tcp.h
+++ b/include/net/tcp.h
@@@ -52,7 -55,15 +52,19 @@@ extern struct inet_hashinfo tcp_hashinf
  DECLARE_PER_CPU(unsigned int, tcp_orphan_count);
  int tcp_orphan_count_sum(void);
  
++<<<<<<< HEAD
 +DECLARE_PER_CPU(u32, tcp_tw_isn);
++=======
+ static inline void tcp_orphan_count_inc(void)
+ {
+ 	this_cpu_inc(tcp_orphan_count);
+ }
+ 
+ static inline void tcp_orphan_count_dec(void)
+ {
+ 	this_cpu_dec(tcp_orphan_count);
+ }
++>>>>>>> 1bbf0ced1d9d (tcp: fix stale per-CPU tcp_tw_isn leak enabling ISN prediction)
  
  void tcp_time_wait(struct sock *sk, int state, int timeo);
  
