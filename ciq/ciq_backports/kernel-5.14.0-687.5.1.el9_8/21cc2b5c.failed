# Conflicts:
#	mm/hugetlb.c
diff --cc mm/hugetlb.c
index 76c4b2c9b5df,eed59cfb5d21..000000000000
--- a/mm/hugetlb.c
+++ b/mm/hugetlb.c
@@@ -5428,10 -5849,9 +5428,10 @@@ void __unmap_hugepage_range(struct mmu_
  	pte_t *ptep;
  	pte_t pte;
  	spinlock_t *ptl;
 +	struct page *page;
  	struct hstate *h = hstate_vma(vma);
  	unsigned long sz = huge_page_size(h);
- 	bool adjust_reservation = false;
+ 	bool adjust_reservation;
  	unsigned long last_addr_mask;
  	bool force_flush = false;
  
@@@ -5522,7 -5943,8 +5522,12 @@@
  					make_pte_marker(PTE_MARKER_UFFD_WP),
  					sz);
  		hugetlb_count_sub(pages_per_huge_page(h), mm);
++<<<<<<< HEAD
 +		page_remove_rmap(page, vma, true);
++=======
+ 		hugetlb_remove_rmap(folio);
+ 		spin_unlock(ptl);
++>>>>>>> 21cc2b5c5062 (mm/hugetlb: add missing hugetlb_lock in __unmap_hugepage_range())
  
  		/*
  		 * Restore the reservation for anonymous page, otherwise the
@@@ -5530,9 -5952,12 +5535,12 @@@
  		 * If there we are freeing a surplus, do not set the restore
  		 * reservation bit.
  		 */
+ 		adjust_reservation = false;
+ 
+ 		spin_lock_irq(&hugetlb_lock);
  		if (!h->surplus_huge_pages && __vma_private_lock(vma) &&
 -		    folio_test_anon(folio)) {
 -			folio_set_hugetlb_restore_reserve(folio);
 +		    folio_test_anon(page_folio(page))) {
 +			folio_set_hugetlb_restore_reserve(page_folio(page));
  			/* Reservation to be adjusted after the spin lock */
  			adjust_reservation = true;
  		}
* Unmerged path mm/hugetlb.c
