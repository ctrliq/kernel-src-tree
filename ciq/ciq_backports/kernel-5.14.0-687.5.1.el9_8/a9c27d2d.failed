   * Per Kerberos v5 protocol spec crypto types from the wire.  These get mapped
   * to linux kernel crypto routines.
@@@ -48,4 -55,67 +58,70 @@@
  #define KEY_USAGE_SEED_ENCRYPTION       (0xAA)
