  	i_mmap_assert_write_locked(vma->vm_file->f_mapping);
  	hugetlb_vma_assert_locked(vma);
++<<<<<<< HEAD
 +	BUG_ON(page_count(virt_to_page(ptep)) == 0);
 +	if (page_count(virt_to_page(ptep)) == 1)
++=======
