  	int idal_len = idaw_nr * sizeof(*idaws);
  	int idaw_size = idal_is_2k(cp) ? PAGE_SIZE / 2 : PAGE_SIZE;
  	int idaw_mask = ~(idaw_size - 1);
@@@ -589,9 -614,12 +609,12 @@@ static int ccw_count_idaws(struct ccw1 
  		if (!cp->orb.cmd.c64)
  			iova = iova >> 32;
  	} else {
