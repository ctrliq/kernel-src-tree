diff --cc drivers/s390/cio/vfio_ccw_cp.c
index 254239411a85,5ef082b8289a..000000000000
--- a/drivers/s390/cio/vfio_ccw_cp.c
+++ b/drivers/s390/cio/vfio_ccw_cp.c
@@@ -183,58 -232,8 +183,59 @@@ static void convert_ccw0_to_ccw1(struc
  	}
  }
  
 +/*
 + * Within the domain (@mdev), copy @n bytes from a guest physical
 + * address (@iova) to a host physical address (@to).
 + */
 +static long copy_from_iova(struct device *mdev,
 +			   void *to, u64 iova,
 +			   unsigned long n)
 +{
 +	struct pfn_array pa = {0};
 +	u64 from;
 +	int i, ret;
 +	unsigned long l, m;
 +
 +	ret = pfn_array_alloc(&pa, idal_nr_words((void *)iova, n));
 +	if (ret < 0)
 +		return ret;
 +
 +	pa.pa_iova = iova;
 +	pa.pa_iova_pfn[0] = pa.pa_iova >> PAGE_SHIFT;
 +	pa.pa_offset[0] = pa.pa_iova & ~PAGE_MASK;
 +	for (i = 1; i < pa.pa_nr; i++)
 +		pa.pa_iova_pfn[i] = pa.pa_iova_pfn[i - 1] + 1;
 +
 +	ret = pfn_array_pin(&pa, mdev);
 +	if (ret < 0) {
 +		pfn_array_unpin_free(&pa, mdev);
 +		return ret;
 +	}
 +
 +	l = n;
 +	for (i = 0; i < pa.pa_nr; i++) {
 +		from = pa.pa_pfn[i] << PAGE_SHIFT;
 +		m = PAGE_SIZE;
 +		if (i == 0) {
 +			from += iova & (PAGE_SIZE - 1);
 +			m -= iova & (PAGE_SIZE - 1);
 +		}
 +
 +		m = min(l, m);
 +		memcpy(to + (n - l), (void *)from, m);
 +
 +		l -= m;
 +		if (l == 0)
 +			break;
 +	}
 +
 +	pfn_array_unpin_free(&pa, mdev);
 +
 +	return l;
 +}
 +
  #define idal_is_2k(_cp) (!(_cp)->orb.cmd.c64 || (_cp)->orb.cmd.i2k)
+ #define get_idaw_size(_cp) ((_cp)->orb.cmd.c64 ? sizeof(u64) : sizeof(u32))
  
  /*
   * Helpers to operate ccwchain.
@@@ -511,13 -518,14 +512,22 @@@ static int ccwchain_fetch_tic(struct cc
  	return -EFAULT;
  }
  
 -static dma64_t *get_guest_idal(struct ccw1 *ccw, struct channel_program *cp, int idaw_nr)
 +static unsigned long *get_guest_idal(struct ccw1 *ccw,
 +				     struct channel_program *cp,
 +				     int idaw_nr)
  {
