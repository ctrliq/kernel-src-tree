--- a/drivers/s390/cio/vfio_ccw_async.c
+++ b/drivers/s390/cio/vfio_ccw_async.c
@@@ -8,7 -8,7 +8,11 @@@
   */
  
  #include <linux/vfio.h>
++<<<<<<< HEAD
 +#include <linux/mdev.h>
++=======
+ #include <linux/nospec.h>
++>>>>>>> 9f5f9a78fedc (s390/vfio_ccw: Ensure index for read/write regions are within range)
  
  #include "vfio_ccw_private.h"
  
diff --cc drivers/s390/cio/vfio_ccw_chp.c
index a646fc81c872,f3015132d4b5..000000000000
--- a/drivers/s390/cio/vfio_ccw_chp.c
+++ b/drivers/s390/cio/vfio_ccw_chp.c
@@@ -8,6 -8,8 +8,11 @@@
   *            Eric Farman <farman@linux.ibm.com>
   */
  
++<<<<<<< HEAD
++=======
+ #include <linux/slab.h>
+ #include <linux/nospec.h>
++>>>>>>> 9f5f9a78fedc (s390/vfio_ccw: Ensure index for read/write regions are within range)
  #include <linux/vfio.h>
  #include "vfio_ccw_private.h"
  
@@@ -24,9 -27,16 +29,16 @@@ static ssize_t vfio_ccw_schib_region_re
  		return -EINVAL;
  
  	mutex_lock(&private->io_mutex);
+ 
+ 	if (i >= private->num_regions) {
+ 		ret = -EINVAL;
+ 		goto out;
+ 	}
+ 
+ 	i = array_index_nospec(i, private->num_regions);
  	region = private->region[i].data;
  
 -	if (cio_update_schib(sch)) {
 +	if (cio_update_schib(private->sch)) {
  		ret = -ENODEV;
  		goto out;
  	}
* Unmerged path drivers/s390/cio/vfio_ccw_async.c
* Unmerged path drivers/s390/cio/vfio_ccw_chp.c
diff --git a/drivers/s390/cio/vfio_ccw_ops.c b/drivers/s390/cio/vfio_ccw_ops.c
index bee98d0c629f..2a2f13afbe5a 100644
--- a/drivers/s390/cio/vfio_ccw_ops.c
+++ b/drivers/s390/cio/vfio_ccw_ops.c
@@ -248,6 +248,7 @@ static ssize_t vfio_ccw_mdev_read(struct mdev_device *mdev,
 		return vfio_ccw_mdev_read_io_region(private, buf, count, ppos);
 	default:
 		index -= VFIO_CCW_NUM_REGIONS;
+		index = array_index_nospec(index, private->num_regions);
 		return private->region[index].ops->read(private, buf, count,
 							ppos);
 	}
@@ -303,6 +304,7 @@ static ssize_t vfio_ccw_mdev_write(struct mdev_device *mdev,
 		return vfio_ccw_mdev_write_io_region(private, buf, count, ppos);
 	default:
 		index -= VFIO_CCW_NUM_REGIONS;
+		index = array_index_nospec(index, private->num_regions);
 		return private->region[index].ops->write(private, buf, count,
 							 ppos);
 	}
@@ -350,11 +352,8 @@ static int vfio_ccw_mdev_get_region_info(struct vfio_region_info *info,
 		    VFIO_CCW_NUM_REGIONS + private->num_regions)
 			return -EINVAL;
 
-		info->index = array_index_nospec(info->index,
-						 VFIO_CCW_NUM_REGIONS +
-						 private->num_regions);
-
 		i = info->index - VFIO_CCW_NUM_REGIONS;
+		i = array_index_nospec(i, private->num_regions);
 
 		info->offset = VFIO_CCW_INDEX_TO_OFFSET(info->index);
 		info->size = private->region[i].size;
