+ 	if (!lsm_backing_file_cache) {
+ 		backing_file_set_security(backing_file, NULL);
+ 		return 0;
+ 	}
+ 
+ 	blob = kmem_cache_zalloc(lsm_backing_file_cache, GFP_KERNEL);
+ 	backing_file_set_security(backing_file, blob);
