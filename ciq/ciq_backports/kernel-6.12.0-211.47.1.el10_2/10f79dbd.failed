+++ b/net/netfilter/nf_tables_api.c
@@@ -2060,7 -2096,9 +2141,13 @@@ static int nf_tables_fill_chain_info(st
  			 NFTA_CHAIN_PAD))
  		goto nla_put_failure;
  
++<<<<<<< HEAD
 +	if (event == NFT_MSG_DELCHAIN && !hook_list) {
++=======
+ 	if (!hook_list && !trans_hook_list &&
+ 	    (event == NFT_MSG_DELCHAIN ||
+ 	     event == NFT_MSG_DESTROYCHAIN)) {
++>>>>>>> 10f79dbd7719 (netfilter: nf_tables: add hook transactions for device deletions)
  		nlmsg_end(skb, nlh);
  		return 0;
  	}
@@@ -9500,7 -9442,9 +9645,13 @@@ static int nf_tables_fill_flowtable_inf
  			 NFTA_FLOWTABLE_PAD))
  		goto nla_put_failure;
  
++<<<<<<< HEAD
 +	if (event == NFT_MSG_DELFLOWTABLE && !hook_list) {
++=======
+ 	if (!hook_list && !trans_hook_list &&
+ 	    (event == NFT_MSG_DELFLOWTABLE ||
+ 	     event == NFT_MSG_DESTROYFLOWTABLE)) {
++>>>>>>> 10f79dbd7719 (netfilter: nf_tables: add hook transactions for device deletions)
  		nlmsg_end(skb, nlh);
  		return 0;
  	}
diff --git a/include/net/netfilter/nf_tables.h b/include/net/netfilter/nf_tables.h
index 5fe20ccf0df4..a70461633e34 100644
--- a/include/net/netfilter/nf_tables.h
+++ b/include/net/netfilter/nf_tables.h
@@ -1213,12 +1213,15 @@ struct nft_stats {
 	struct u64_stats_sync	syncp;
 };
 
+#define NFT_HOOK_REMOVE	(1 << 0)
+
 struct nft_hook {
 	struct list_head	list;
 	struct list_head	ops_list;
 	struct rcu_head		rcu;
 	char			ifname[IFNAMSIZ];
 	u8			ifnamelen;
+	u8			flags;
 };
 
 struct nf_hook_ops *nft_hook_find_ops(const struct nft_hook *hook,
@@ -1673,6 +1676,16 @@ struct nft_trans {
 	u8				put_net:1;
 };
 
+/**
+ * struct nft_trans_hook - nf_tables hook update in transaction
+ * @list: used internally
+ * @hook: struct nft_hook with the device hook
+ */
+struct nft_trans_hook {
+	struct list_head		list;
+	struct nft_hook			*hook;
+};
+
 /**
  * struct nft_trans_binding - nf_tables object with binding support in transaction
  * @nft_trans:    base structure, MUST be first member
* Unmerged path net/netfilter/nf_tables_api.c
