diff --git a/include/net/ip.h b/include/net/ip.h
index 893117ecf9dd..d0d50614f6b8 100644
--- a/include/net/ip.h
+++ b/include/net/ip.h
@@ -67,6 +67,13 @@ static inline unsigned int ip_hdrlen(const struct sk_buff *skb)
 	return ip_hdr(skb)->ihl * 4;
 }
 
+static inline int ip_check_csum_start(const struct sk_buff *skb)
+{
+	if (unlikely(skb->csum_start < skb->network_header + ip_hdrlen(skb)))
+		return -EINVAL;
+	return 0;
+}
+
 struct ipcm_cookie {
 	struct sockcm_cookie	sockc;
 	__be32			addr;
