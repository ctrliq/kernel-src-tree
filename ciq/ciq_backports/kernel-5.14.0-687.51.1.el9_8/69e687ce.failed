netfilter: nf_tables: missing objects with no memcg accounting

jira KERNEL-1646
Rebuild_History Non-Buildable kernel-5.14.0-687.51.1.el9_8
commit-author Pablo Neira Ayuso <pablo@netfilter.org>
commit 69e687cea79fc99a17dfb0116c8644b9391b915e
Empty-Commit: Cherry-Pick Conflicts during history rebuild.
Will be included in final tarball splat. Ref for failed cherry-pick at:
ciq/ciq_backports/kernel-5.14.0-687.51.1.el9_8/69e687ce.failed

Several ruleset objects are still not using GFP_KERNEL_ACCOUNT for
memory accounting, update them. This includes:

- catchall elements
- compat match large info area
- log prefix
- meta secctx
- numgen counters
- pipapo set backend datastructure
- tunnel private objects

Fixes: 33758c891479 ("memcg: enable accounting for nft objects")
	Signed-off-by: Pablo Neira Ayuso <pablo@netfilter.org>
(cherry picked from commit 69e687cea79fc99a17dfb0116c8644b9391b915e)
	Signed-off-by: Jonathan Maple <jmaple@ciq.com>

# Conflicts:
#	net/netfilter/nft_numgen.c
#	net/netfilter/nft_set_pipapo.c
diff --cc net/netfilter/nft_numgen.c
index f3391583abe4,bd058babfc82..000000000000
--- a/net/netfilter/nft_numgen.c
+++ b/net/netfilter/nft_numgen.c
@@@ -65,10 -66,32 +65,16 @@@ static int nft_ng_inc_init(const struc
  	if (priv->offset + priv->modulus - 1 < priv->offset)
  		return -EOVERFLOW;
  
++<<<<<<< HEAD
 +	atomic_set(&priv->counter, priv->modulus - 1);
++=======
+ 	priv->counter = kmalloc(sizeof(*priv->counter), GFP_KERNEL_ACCOUNT);
+ 	if (!priv->counter)
+ 		return -ENOMEM;
++>>>>>>> 69e687cea79f (netfilter: nf_tables: missing objects with no memcg accounting)
  
 -	atomic_set(priv->counter, priv->modulus - 1);
 -
 -	err = nft_parse_register_store(ctx, tb[NFTA_NG_DREG], &priv->dreg,
 -				       NULL, NFT_DATA_VALUE, sizeof(u32));
 -	if (err < 0)
 -		goto err;
 -
 -	return 0;
 -err:
 -	kfree(priv->counter);
 -
 -	return err;
 -}
 -
 -static bool nft_ng_inc_reduce(struct nft_regs_track *track,
 -				 const struct nft_expr *expr)
 -{
 -	const struct nft_ng_inc *priv = nft_expr_priv(expr);
 -
 -	nft_reg_track_cancel(track, priv->dreg, NFT_REG32_SIZE);
 -
 -	return false;
 +	return nft_parse_register_store(ctx, tb[NFTA_NG_DREG], &priv->dreg,
 +					NULL, NFT_DATA_VALUE, sizeof(u32));
  }
  
  static int nft_ng_dump(struct sk_buff *skb, enum nft_registers dreg,
