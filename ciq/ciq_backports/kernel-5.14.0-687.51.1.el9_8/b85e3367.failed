+ 	new_mt = kvmalloc_array(rules_alloc, sizeof(*new_mt), GFP_KERNEL_ACCOUNT);
++>>>>>>> b85e3367a571 (netfilter: nft_set_pipapo: clamp maximum map bucket size to INT_MAX)
  	if (!new_mt)
  		return -ENOMEM;
  
@@@ -1470,8 -1502,12 +1477,11 @@@ static struct nft_pipapo_match *pipapo_
