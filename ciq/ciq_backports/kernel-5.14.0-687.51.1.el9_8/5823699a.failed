diff --cc net/netfilter/nft_set_pipapo_avx2.c
index fe91f62cc4fb,7ff90325c97f..000000000000
--- a/net/netfilter/nft_set_pipapo_avx2.c
+++ b/net/netfilter/nft_set_pipapo_avx2.c
@@@ -1180,23 -1177,8 +1180,22 @@@ nft_pipapo_avx2_lookup(const struct ne
  	 */
  	kernel_fpu_begin_mask(0);
  
 +	scratch = *raw_cpu_ptr(m->scratch);
 +	if (unlikely(!scratch)) {
 +		kernel_fpu_end();
 +		local_bh_enable();
 +		return NULL;
 +	}
 +
 +	map_index = scratch->map_index;
 +
 +	res  = scratch->map + (map_index ? m->bsize_max : 0);
 +	fill = scratch->map + (map_index ? 0 : m->bsize_max);
 +
 +	pipapo_resmap_init_avx2(m, res);
 +
  	nft_pipapo_avx2_prepare();
  
- next_match:
  	nft_pipapo_for_each_field(f, i, m) {
  		bool last = i == m->field_count - 1, first = !i;
  		int ret = 0;
@@@ -1243,29 -1225,78 +1242,48 @@@
  
  #undef NFT_SET_PIPAPO_AVX2_LOOKUP
  
++<<<<<<< HEAD
 +		if (ret < 0)
 +			goto out;
++=======
+ next_match:
+ 		if (ret < 0) {
+ 			scratch->map_index = map_index;
+ 			kernel_fpu_end();
+ 			__local_unlock_nested_bh(&scratch->bh_lock);
+ 			return NULL;
+ 		}
++>>>>>>> 5823699a11cf (netfilter: nft_set_pipapo_avx2: fix skip of expired entries)
  
  		if (last) {
 -			struct nft_pipapo_elem *e;
 +			const struct nft_set_ext *e = &f->mt[ret].e->ext;
  
++<<<<<<< HEAD
 +			if (unlikely(nft_set_elem_expired(e) ||
 +				     !nft_set_elem_active(e, genmask)))
++=======
+ 			e = f->mt[ret].e;
+ 			if (unlikely(__nft_set_elem_expired(&e->ext, tstamp) ||
+ 				     !nft_set_elem_active(&e->ext, genmask))) {
+ 				ret = pipapo_refill(res, f->bsize, f->rules,
+ 						    fill, f->mt, last);
++>>>>>>> 5823699a11cf (netfilter: nft_set_pipapo_avx2: fix skip of expired entries)
  				goto next_match;
+ 			}
  
 -			scratch->map_index = map_index;
 -			kernel_fpu_end();
 -			__local_unlock_nested_bh(&scratch->bh_lock);
 -			return e;
 +			ext = e;
 +			goto out;
  		}
  
 -		map_index = !map_index;
  		swap(res, fill);
 -		data += NFT_PIPAPO_GROUPS_PADDED_SIZE(f);
 +		rp += NFT_PIPAPO_GROUPS_PADDED_SIZE(f);
  	}
  
 +out:
 +	if (i % 2)
 +		scratch->map_index = !map_index;
  	kernel_fpu_end();
 -	__local_unlock_nested_bh(&scratch->bh_lock);
 -	return NULL;
 -}
