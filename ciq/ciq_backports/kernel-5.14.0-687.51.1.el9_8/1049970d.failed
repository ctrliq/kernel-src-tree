  	if (!nf_flow_dst_check(&tuplehash->tuple)) {
  		flow_offload_teardown(flow);
 -		return 0;
 +		return NF_ACCEPT;
  	}
  
++<<<<<<< HEAD
 +	if (skb_try_make_writable(skb, thoff + hdrsize))
 +		return NF_DROP;
++=======
+ 	if (skb_ensure_writable(skb, thoff + ctx->hdrsize))
+ 		return -1;
++>>>>>>> 1049970d7583 (netfilter: replace skb_try_make_writable() by skb_ensure_writable())
  
  	flow_offload_refresh(flow_table, flow, false);
  
@@@ -604,11 -1034,11 +609,16 @@@ nf_flow_offload_ipv6_hook(void *priv, s
  
  	if (!nf_flow_dst_check(&tuplehash->tuple)) {
  		flow_offload_teardown(flow);
 -		return 0;
 +		return NF_ACCEPT;
  	}
  
++<<<<<<< HEAD
 +	if (skb_try_make_writable(skb, thoff + hdrsize))
 +		return NF_DROP;
++=======
+ 	if (skb_ensure_writable(skb, thoff + ctx->hdrsize))
+ 		return -1;
++>>>>>>> 1049970d7583 (netfilter: replace skb_try_make_writable() by skb_ensure_writable())
  
