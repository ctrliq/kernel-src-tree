--- a/net/netfilter/nft_set_pipapo.c
+++ b/net/netfilter/nft_set_pipapo.c
@@@ -936,7 -964,7 +964,11 @@@ static void pipapo_lt_bits_adjust(struc
  		return;
  	}
  
++<<<<<<< HEAD
 +	new_lt = kvzalloc(lt_size + NFT_PIPAPO_ALIGN_HEADROOM, GFP_KERNEL);
++=======
+ 	new_lt = kvzalloc(lt_size, GFP_KERNEL_ACCOUNT);
++>>>>>>> 4c5c6aa9967d (netfilter: nft_set_pipapo: prevent overflow in lookup table allocation)
  	if (!new_lt)
  		return;
  
@@@ -1455,10 -1483,11 +1488,18 @@@ static struct nft_pipapo_match *pipapo_
  
  		memcpy(dst, src, offsetof(struct nft_pipapo_field, lt));
  
++<<<<<<< HEAD
 +		new_lt = kvzalloc(src->groups * NFT_PIPAPO_BUCKETS(src->bb) *
 +				  src->bsize * sizeof(*dst->lt) +
 +				  NFT_PIPAPO_ALIGN_HEADROOM,
 +				  GFP_KERNEL);
++=======
+ 		lt_size = lt_calculate_size(src->groups, src->bb, src->bsize);
+ 		if (lt_size < 0)
+ 			goto out_lt;
+ 
+ 		new_lt = kvzalloc(lt_size, GFP_KERNEL_ACCOUNT);
++>>>>>>> 4c5c6aa9967d (netfilter: nft_set_pipapo: prevent overflow in lookup table allocation)
  		if (!new_lt)
  			goto out_lt;
  
* Unmerged path net/netfilter/nft_set_pipapo.c
