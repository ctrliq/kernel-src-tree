@@@ -1161,31 -1159,9 +1167,31 @@@ static struct nft_pipapo_elem *pipapo_g
  	bool map_index;
  	int i;
  
++<<<<<<< HEAD
 +	local_bh_disable();
 +
 +	if (unlikely(!irq_fpu_usable())) {
 +		ext = nft_pipapo_lookup(net, set, key);
 +
 +		local_bh_enable();
 +		return ext;
 +	}
 +
 +	m = rcu_dereference(priv->match);
