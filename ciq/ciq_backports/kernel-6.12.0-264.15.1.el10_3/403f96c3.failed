@@@ -1578,19 -1583,18 +1582,32 @@@ static void __ovs_ct_free_action(struc
  #if	IS_ENABLED(CONFIG_NETFILTER_CONNCOUNT)
  static int ovs_ct_limit_init(struct net *net, struct ovs_net *ovs_net)
  {
+ 	struct ovs_ct_limit_info *info;
  	int i, err;
  
