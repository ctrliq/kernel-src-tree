diff --git a/include/net/if_inet6.h b/include/net/if_inet6.h
index 5b9e4ab5cc0b..8182b403d378 100644
--- a/include/net/if_inet6.h
+++ b/include/net/if_inet6.h
@@ -75,6 +75,8 @@ struct inet6_ifaddr {
 
