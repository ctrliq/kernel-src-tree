 +	}
  
 -	if (ifa->rt_priority &&
 -	    nla_put_u32(skb, IFA_RT_PRIORITY, ifa->rt_priority))
 +	priority = READ_ONCE(ifa->rt_priority);
 +	if (priority && nla_put_u32(skb, IFA_RT_PRIORITY, priority))
