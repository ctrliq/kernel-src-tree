+  */
+ static inline void pasid_set_fault_enable(struct pasid_entry *pe)
+ {
+ 	pasid_set_bits(&pe->val[0], 1 << 1, 0);
+ }
+ 
+ /*
+  * Enable second level A/D bits by setting the SLADE (Second Level
