+  */
+ static inline void
+ pasid_set_flpm(struct pasid_entry *pe, u64 value)
+ {
+ 	pasid_set_bits(&pe->val[2], GENMASK_ULL(3, 2), value << 2);
+ }
+ 
+ /*
+  * Setup the Extended Access Flag Enable (EAFE) field (Bit 135)
