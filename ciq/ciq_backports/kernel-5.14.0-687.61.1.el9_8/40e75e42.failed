+ 	}
+ 	if (cifs_convert_flags(oflags, orw) != cifs_convert_flags(cflags, crw))
+ 		return false;
+ 
+ 	return (oflags & (O_SYNC | O_DIRECT)) == (cflags & (O_SYNC | O_DIRECT));
+ }
