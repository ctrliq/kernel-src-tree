diff --cc fs/smb/common/fscc.h
index 0123f34db1e8,941db5a95564..000000000000
--- a/fs/smb/common/fscc.h
+++ b/fs/smb/common/fscc.h
@@@ -47,6 -279,16 +47,19 @@@ typedef struct 
  } __packed FILE_DIRECTORY_INFO;   /* level 0x101 FF resp data */
  
  /* See MS-FSCC 2.4.14 */
++<<<<<<< HEAD
++=======
+ struct smb2_file_eof_info { /* encoding of request for level 10 */
+ 	__le64 EndOfFile; /* new end of file value */
+ } __packed; /* level 20 Set */
+ 
+ /* See MS-FSCC 2.4.4 */
+ struct smb2_file_alloc_info { /* encoding of request for level 19 */
+ 	__le64 AllocationSize;
+ } __packed;
+ 
+ /* See MS-FSCC 2.4.15 */
++>>>>>>> 5bd1d3dcc25a (smb/client: refresh allocation after EOF-extending fallocate)
  typedef struct {
  	__le32 NextEntryOffset;
  	__u32 FileIndex;
* Unmerged path fs/smb/server/smb2pdu.h
