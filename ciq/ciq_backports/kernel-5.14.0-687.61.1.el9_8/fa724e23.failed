+++ b/fs/smb/client/inode.c
@@@ -3013,6 -3050,16 +3013,11 @@@ void cifs_setsize(struct inode *inode, 
  	spin_unlock(&inode->i_lock);
  	inode_set_mtime_to_ts(inode, inode_set_ctime_current(inode));
  	truncate_pagecache(inode, offset);
