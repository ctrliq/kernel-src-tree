+++ b/arch/arm64/include/asm/kvm_hyp.h
@@@ -146,5 -156,7 +146,10 @@@ extern u64 kvm_nvhe_sym(id_aa64smfr0_el
  extern unsigned long kvm_nvhe_sym(__icache_flags);
  extern unsigned int kvm_nvhe_sym(kvm_arm_vmid_bits);
  extern unsigned int kvm_nvhe_sym(kvm_host_sve_max_vl);
++<<<<<<< HEAD
++=======
+ extern unsigned long kvm_nvhe_sym(hyp_nr_cpus);
+ extern unsigned int kvm_nvhe_sym(hyp_gicv3_nr_lr);
++>>>>>>> 8cc8bbbfab14 (KVM: arm64: Bound used_lrs when flushing the pKVM hyp vCPU)
  
  #endif /* __ARM64_KVM_HYP_H__ */
diff --cc arch/arm64/kvm/hyp/nvhe/hyp-main.c
index 29430c031095,a0da08caa6c2..000000000000
--- a/arch/arm64/kvm/hyp/nvhe/hyp-main.c
+++ b/arch/arm64/kvm/hyp/nvhe/hyp-main.c
@@@ -136,6 -144,14 +139,17 @@@ static void flush_hyp_vcpu(struct pkvm_
  	hyp_vcpu->vcpu.arch.vsesr_el2	= host_vcpu->arch.vsesr_el2;
  
  	hyp_vcpu->vcpu.arch.vgic_cpu.vgic_v3 = host_vcpu->arch.vgic_cpu.vgic_v3;
++<<<<<<< HEAD
++=======
+ 
+ 	/* Bound used_lrs by the number of implemented list registers. */
+ 	hyp_vcpu->vcpu.arch.vgic_cpu.vgic_v3.used_lrs =
+ 		min_t(unsigned int,
+ 		      hyp_vcpu->vcpu.arch.vgic_cpu.vgic_v3.used_lrs,
+ 		      hyp_gicv3_nr_lr);
+ 
+ 	hyp_vcpu->vcpu.arch.pid = host_vcpu->arch.pid;
++>>>>>>> 8cc8bbbfab14 (KVM: arm64: Bound used_lrs when flushing the pKVM hyp vCPU)
  }
  
  static void sync_hyp_vcpu(struct pkvm_hyp_vcpu *hyp_vcpu)
